<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RemoteFlow.Protocol.PowerShell —— PowerShell 远程会话（仅 Windows）。
    不自研 WinRM 协议，也不嵌入 PowerShell SDK：用 Windows 伪终端（ConPTY）启动系统自带的
    powershell.exe，由它执行 New-PSSession / Enter-PSSession，画面接到应用内的终端。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>RemoteFlow.Protocol.PowerShell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteFlow.Core\RemoteFlow.Core.csproj" />
    <InternalsVisibleTo Include="RemoteFlow.IntegrationTests.Windows" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="bootstrap.ps1" LogicalName="RemoteFlow.Protocol.PowerShell.bootstrap.ps1" />
    <EmbeddedResource Include="enable.ps1" LogicalName="RemoteFlow.Protocol.PowerShell.enable.ps1" />
  </ItemGroup>

</Project>
