<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RemoteFlow.App.Mac —— macOS 客户端（原生 AppKit / net10.0-macos）。
    复用平台无关的 RemoteFlow.Presentation（ViewModel / 服务 / 终端资产）
    与 RemoteFlow.Protocol.* / Infrastructure.Mac。
    对应 macOS 版技术方案 v1.3 §8（原 Avalonia 方案已弃，见 §3.4）。

    不进 RemoteFlow.slnx：net10.0-macos 无法跨平台构建，作为 macOS 专属叶子独立 build。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>RemoteFlow.App.Mac</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>RemoteFlow</ApplicationTitle>
    <ApplicationId>com.remoteflow.mac</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>

    <!--
      本机 Xcode 26.3（macOS SDK 26.2）低于 .NET macos pack 期望的 SDK 26.5。
      spike 已验证：本项目仅用稳定 AppKit/WebKit API，跳过版本校验可正常构建运行。
      正式发布前应升级 Xcode 或固定匹配的 SDK pack（见 v1.3 §8.A / §13）。
    -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>

    <!--
      同上 SDK 版本差：Release 的 ILLink「Setup」+ 静态 registrar 需 macOS 26.5 SDK 头文件（MM0179）。
      关裁剪 + 动态 registrar（运行期注册，绕过编译期头文件依赖）；正式发布升级 Xcode 后
      恢复默认（静态 registrar + 裁剪）进一步瘦身 / 提速（见 §8.F）。
    -->
    <LinkMode>None</LinkMode>
    <Registrar>dynamic</Registrar>
    <RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteFlow.Core\RemoteFlow.Core.csproj" />
    <ProjectReference Include="..\RemoteFlow.Application\RemoteFlow.Application.csproj" />
    <ProjectReference Include="..\RemoteFlow.Presentation\RemoteFlow.Presentation.csproj" />
    <ProjectReference Include="..\RemoteFlow.Infrastructure\RemoteFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\RemoteFlow.Infrastructure.Mac\RemoteFlow.Infrastructure.Mac.csproj" />
    <ProjectReference Include="..\RemoteFlow.Protocol.Ssh\RemoteFlow.Protocol.Ssh.csproj" />
    <ProjectReference Include="..\RemoteFlow.Protocol.Vnc\RemoteFlow.Protocol.Vnc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App 图标：iconset → AppIcon.icns，经 Info.plist 的 CFBundleIconFile 引用。 -->
    <BundleResource Include="Resources\AppIcon.icns" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
