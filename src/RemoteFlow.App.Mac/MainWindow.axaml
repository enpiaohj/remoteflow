<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RemoteFlow.App.Mac.MainWindow"
        Width="860" Height="560"
        MinWidth="640" MinHeight="420"
        Title="RemoteFlow">
  <DockPanel Margin="16">

    <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12">
      统一远程连接工作台 <Run FontSize="12" Foreground="Gray">— macOS 客户端（Phase 3 骨架）</Run>
    </TextBlock>

    <Border DockPanel.Dock="Top" Margin="0,0,0,14" Padding="14,10"
            Background="#18FFFFFF" CornerRadius="8">
      <StackPanel Spacing="6" x:Name="ChecksPanel" />
    </Border>

    <StackPanel x:Name="ContentPanel" Spacing="10">
      <TextBlock Text="会话来宾席 —— 下一步接入 SSH 终端（WebView + xterm.js）" 
                 Foreground="Gray" FontSize="13" />
    </StackPanel>

  </DockPanel>
</Window>
