<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        浅色主题调色板（默认主题）。
        所有控件样式只引用这里的语义键（Bg.* / Text.* / Stroke.* / Brand.*），
        因此切换主题时无需改动任何控件模板。

        结构原则「机身 + 纸张」：
        标题栏 / 侧栏 / 标签条同属机身（Bg.Chrome），是同一块冷中性底；
        中央工作区是浮在机身之上的一张白纸（Bg.Layer）。
        两者拉开足够色差，界面才有「一台工具」而不是「一片白」的观感。
        中性色统一偏冷（带一点蓝），比纯灰更耐看、也更像专业工具。
    -->

    <!-- 机身：标题栏、侧栏、标签条 -->
    <SolidColorBrush x:Key="Bg.Base" Color="#EDEFF3" />
    <SolidColorBrush x:Key="Bg.Sidebar" Color="#EDEFF3" />
    <!-- 纸张：中央内容区 -->
    <SolidColorBrush x:Key="Bg.Layer" Color="#FFFFFF" />
    <!-- 纸张之上的凹陷区（表头、内嵌块） -->
    <SolidColorBrush x:Key="Bg.Subtle" Color="#F4F6F9" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#EBEEF3" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="#E1E5EC" />
    <SolidColorBrush x:Key="Bg.Selected" Color="#E8EEFD" />
    <SolidColorBrush x:Key="Bg.SelectedHover" Color="#DCE6FB" />
    <SolidColorBrush x:Key="Bg.Session" Color="#141619" />

    <!-- 文字层级：3 级灰度 + 反色。灰度同样偏冷，与背景同源 -->
    <SolidColorBrush x:Key="Text.Primary" Color="#171A1F" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#596273" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8A93A3" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#AEB6C2" />

    <!-- 描边：优先用间距与色阶分隔区域，描边只在必要处使用 -->
    <SolidColorBrush x:Key="Stroke.Subtle" Color="#E7EAEF" />
    <SolidColorBrush x:Key="Stroke.Default" Color="#D8DDE5" />
    <SolidColorBrush x:Key="Stroke.Strong" Color="#BFC7D2" />
    <SolidColorBrush x:Key="Stroke.Focus" Color="#2B62D9" />

    <!-- 品牌色：全应用唯一主操作色。比系统蓝更深更纯，避免「默认控件」感 -->
    <Color x:Key="Brand.Color">#2B62D9</Color>
    <SolidColorBrush x:Key="Brand.Default" Color="#2B62D9" />
    <SolidColorBrush x:Key="Brand.Hover" Color="#2453BE" />
    <SolidColorBrush x:Key="Brand.Pressed" Color="#1C4299" />
    <SolidColorBrush x:Key="Brand.Subtle" Color="#EDF2FD" />

    <!-- 状态色。注意：状态绝不单独依赖颜色传达，必须同时有文字或图标 -->
    <SolidColorBrush x:Key="Status.Success" Color="#14804A" />
    <SolidColorBrush x:Key="Status.Warning" Color="#A25B00" />
    <SolidColorBrush x:Key="Status.Danger" Color="#C4342A" />
    <SolidColorBrush x:Key="Status.DangerHover" Color="#A82B22" />
    <SolidColorBrush x:Key="Status.Info" Color="#2B62D9" />
    <SolidColorBrush x:Key="Status.Idle" Color="#8A93A3" />

    <!-- 协议标识色：三色相互拉开，同时都能落在浅色底上保持可读 -->
    <SolidColorBrush x:Key="Protocol.Rdp" Color="#2B62D9" />
    <SolidColorBrush x:Key="Protocol.Ssh" Color="#0E7C57" />
    <SolidColorBrush x:Key="Protocol.Vnc" Color="#7A4FC4" />

    <SolidColorBrush x:Key="Shadow.Color" Color="#14101828" />

</ResourceDictionary>
