<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        基础控件样式：排版、按钮、输入控件。
        设计约束（产品设计文档 §7.10）：
          · 8px 栅格
          · 最多 4 个主要字号层级
          · 常用按钮/图标目标区域不小于 40px
          · 动画快速克制，仅用于状态反馈
    -->

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="UiFontDisplay">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- 字号阶梯：28 / 17 / 15 / 13 / 12 / 11。
         Title 与 Section 之间补一级 Subtitle，避免整个应用只有 3px 的层级跨度。 -->
    <sys:Double x:Key="FontSize.Title">28</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">17</sys:Double>
    <sys:Double x:Key="FontSize.Section">15</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Label">11</sys:Double>

    <!-- 圆角语言：控件 6 / 图标块与小面板 8 / 卡片与工作区 12。
         同一界面里控件比容器更方，层级才不会糊在一起。 -->
    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <Duration x:Key="Duration.Fast">0:0:0.12</Duration>

    <!-- ══ RemoteFlow 图标系统 ═══════════════════════════════════════
         之前每个页面各写一套图标块数字（30/34/36/38/40…、圆角 5~19、
         背景不透明度 0.13~0.18 不等），是「零散替换」的根源。统一成一套：

         · 字体固定 Segoe Fluent Icons（回退 Segoe MDL2 Assets）——这是
           Windows 11 系统自带、当前机器已确认可用的 Fluent 风格图标字体。
           独立分发的「Microsoft Fluent System Icons」开源字体文件本机
           没有、也没有网络环境下载安装，无法作为应用内嵌字体使用；
           两者视觉语言一致（同属 Fluent，多数字形是描边 / Regular 粗细），
           这里退而求其次，但图标"系统"本身（尺寸/圆角/透明度/语义/取色
           规则）与用哪个字体文件无关，一样统一管理。
         · 标准尺寸 44，对齐首页「收藏 / 最近活动」行的图标尺度——这也是
           除首页「最近连接」大卡片（64，唯一的放大例外）外全应用统一
           使用的「列表项图标」规格。
         · 背景不再是显眼的高饱和色块，统一压到 12% 不透明度；
           真正传达「这是什么类型」的是图标本身的颜色，不是背景色块。
         · 圆角统一用 Radius.Medium（8），不再各页面各挑一个数字。
    -->
    <sys:Double x:Key="IconTile.Size">44</sys:Double>
    <sys:Double x:Key="IconTile.GlyphSize">19</sys:Double>
    <!-- 彩色背景（协议色 / 类型色）统一按这个不透明度冲淡，中性背景
         （Bg.Subtle 等本就很浅的灰）不套这个值，在使用处不设 Opacity 即可 -->
    <sys:Double x:Key="IconTile.ColorBgOpacity">0.12</sys:Double>

    <!-- 图标块背景：Width/Height/CornerRadius 统一，Background/Opacity 按
         语义在使用处设置（协议色/类型色要配 IconTile.ColorBgOpacity 冲淡；
         Bg.Subtle 这类本就浅的中性背景不设 Opacity，否则会淡到看不见） -->
    <Style x:Key="IconTile.Background" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource IconTile.Size}" />
        <Setter Property="Height" Value="{StaticResource IconTile.Size}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
    </Style>

    <!-- 图标块字形：字体 / 字号 / 对齐统一，Foreground 同上按语义绑定 -->
    <Style x:Key="IconTile.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="{StaticResource IconTile.GlyphSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 会话状态点：叠在图标块右下角。空闲隐藏（可见性由使用处按 HasActiveSession 绑定），
         仅连接中 / 已连接时点亮。外圈用页面底色描一圈，把点从图标块里"抬"出来。
         内点 Fill 由 SessionStatusDot.Fill 按 IsConnected 决定绿 / 琥珀。 -->
    <Style x:Key="SessionStatusDot" TargetType="Border">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Bg.Layer}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,-4,-4" />
    </Style>

    <Style x:Key="SessionStatusDot.Fill" TargetType="Ellipse">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- 默认琥珀 = 连接中；IsConnected 时转绿 -->
        <Setter Property="Fill" Value="{DynamicResource Status.Warning}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Status.Success}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── 排版 ───────────────────────────────────────────────── -->

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 页面标题下的一句说明，替代「标题孤零零杵在那」的排版 -->
    <Style x:Key="Text.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 列表表头 / 分区标签：小字号 + 半粗 + 三级灰，安静但可辨认 -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        键帽徽标：搜索框的「Ctrl K」提示、关于对话框的快捷键列表都用这个外观。
        只定容器视觉（背景/描边/圆角/内边距），内容自己放 TextBlock，
        字号/字重跟着放进去的 Text.Label 走，这里不重复定义。
    -->
    <Style x:Key="Kbd" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.BodySecondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 表单字段标签：右对齐、次级灰度，与输入框基线对齐 -->
    <Style x:Key="Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- 图标文本 -->
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <!-- ── 按钮 ───────────────────────────────────────────────── -->

    <!-- 次要按钮（默认样式）：白底描边，用于「取消」等非主操作 -->
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Bg.Layer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 焦点环画在控件外侧 2px，聚焦时不改变边框粗细，避免布局跳动 -->
                    <Grid Margin="-3">
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Stroke.Focus}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource Radius.Medium}"
                                Opacity="0"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="Root"
                                Margin="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Small}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Content"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Pressed}" />
                            <Setter TargetName="Content" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Subtle}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作按钮：全应用唯一强调色，一个界面中只应出现一个 -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="{DynamicResource Brand.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="-3">
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource Stroke.Focus}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource Radius.Medium}"
                                Opacity="0"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="Root"
                                Margin="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Small}"
                                SnapsToDevicePixels="True">
                            <!-- 顶部一道极淡的高光，让实色按钮有一点立体感而不是一块死色 -->
                            <Grid>
                                <Border x:Name="Sheen"
                                        CornerRadius="{StaticResource Radius.Small}"
                                        VerticalAlignment="Stretch">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#26FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter x:Name="Content"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brand.Hover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brand.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brand.Pressed}" />
                            <Setter TargetName="Sheen" Property="Opacity" Value="0" />
                            <Setter TargetName="Content" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Subtle}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
                            <Setter TargetName="Sheen" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险操作按钮：单独使用系统警示色，与主操作色明确区分 -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Background" Value="{DynamicResource Status.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Danger}" />
    </Style>

    <!-- 无边框按钮：用于列表内联操作与工具条 -->
    <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- 图标按钮：36x36 保证足够的点击目标 -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- ── 输入控件 ───────────────────────────────────────────── -->

    <!--
        Fluent 风格输入框：常态为细描边，聚焦时底部出现 2px 强调线。
        这个「底部强调线」是 Windows 11 输入控件最显著的识别特征。
    -->
    <ControlTemplate x:Key="Template.InputSurface" TargetType="Control">
        <Grid>
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Small}"
                    SnapsToDevicePixels="True" />
            <Border x:Name="FocusLine"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Margin="1,0,1,0"
                    Background="{DynamicResource Brand.Default}"
                    CornerRadius="0,0,3,3"
                    Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="Input.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brand.Default}" />
        <Setter Property="Background" Value="{DynamicResource Bg.Layer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Small}"
                                SnapsToDevicePixels="True" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                        <Border x:Name="FocusLine"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Margin="1,0,1,0"
                                Background="{DynamicResource Brand.Default}"
                                CornerRadius="0,0,3,3"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 多行文本（备注） -->
    <Style x:Key="Input.TextArea" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- 密码框：UI 默认不显示密码明文 -->
    <Style x:Key="Input.PasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Bg.Layer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Small}"
                                SnapsToDevicePixels="True" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False" />
                        <Border x:Name="FocusLine"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Margin="1,0,1,0"
                                Background="{DynamicResource Brand.Default}"
                                CornerRadius="0,0,3,3"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Stroke.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 复选框 ─────────────────────────────────────────────── -->

    <Style x:Key="Input.CheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent" Padding="0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    Background="{DynamicResource Bg.Layer}"
                                    BorderBrush="{DynamicResource Stroke.Strong}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <TextBlock x:Name="Check"
                                           Text="&#xE73E;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.OnAccent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brand.Default}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brand.Default}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brand.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 开关 / 分段 ────────────────────────────────────────── -->

    <!-- iOS 风格开关。用于「是/否」类设置，比复选框更贴近 Fluent 的设置界面。 -->
    <Style x:Key="Toggle.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                            Background="{DynamicResource Bg.Subtle}"
                            BorderBrush="{DynamicResource Stroke.Strong}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Ellipse x:Name="Knob" Width="14" Height="14"
                                 Fill="{DynamicResource Text.Secondary}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brand.Default}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brand.Default}" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brand.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段选择：一组互斥的按钮，用于主题这类 2~4 个取值的选择 -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource Bg.Layer}"
                            BorderBrush="{DynamicResource Stroke.Default}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,7"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Selected}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brand.Default}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brand.Default}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 卡片 / 分隔 ────────────────────────────────────────── -->

    <!-- 卡片：白纸 + 细描边 + 一层很淡的投影。投影让卡片真正「浮」在机身之上，
         是廉价感与成熟感之间最直接的一档差别。
         注意：Surface.Card 只用在页面内容与会话中断提示卡上，不包裹 RDP ActiveX 宿主，
         因此这里用 Effect 不影响 airspace。 -->
    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Layer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource Shadow.Cast}"
                                  BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Surface.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Stroke.Subtle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
