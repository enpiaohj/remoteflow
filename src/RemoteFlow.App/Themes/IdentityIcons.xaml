    <!--
        RemoteFlow 身份图标（Id.*）：表达「这是什么」的彩色矢量图标——凭据类型、设置分区、首页 / 帮助 / 关于分区、
        对话框级别、空状态等。与设备图标（DeviceIcons.xaml）同一设计语言：64×64 画布、渐变主体、
        右下偏移阴影层、左上白色高光，全部为 WPF 原生矢量 DrawingImage，原创绘制。
        通过 KeyToImageSource 取用；单色操作图标见 UiIcons.xaml。
        本字典内画刷就地定义，不引用其它字典（合并字典之间的 StaticResource 解析顺序不可靠）。
    -->

    <LinearGradientBrush x:Key="Id.Blue" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#46C7FF" Offset="0" />
        <GradientStop Color="#1685E8" Offset="0.52" />
        <GradientStop Color="#2453D5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Id.Indigo" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7E95FF" Offset="0" />
        <GradientStop Color="#3352CE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Id.Purple" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A56AF2" Offset="0" />
        <GradientStop Color="#6232BE" Offset="1" />
