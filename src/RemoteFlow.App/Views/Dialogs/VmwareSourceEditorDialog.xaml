<Window x:Class="RemoteFlow.App.Views.Dialogs.VmwareSourceEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextElement.Foreground="{DynamicResource Text.Primary}">

    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Margin="28,26,28,0">
                <TextBlock x:Name="TitleBar" Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="添加一台独立的 ESXi 主机，或一台 vCenter。虚拟机不会保存在 RemoteFlow 里，每次打开页面都从服务器实时读取。" />

                <TextBlock Text="显示名称" Style="{StaticResource Text.Caption}" Margin="0,18,0,6" />
                <TextBox Style="{StaticResource Input.TextBox}" MaxLength="60"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="主机地址" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Input.TextBox}"
                                 Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HTTPS 端口" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Input.TextBox}"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- 第 1 步：证书指纹。自签名证书很常见，必须由用户核对后才信任，之后只认这一张。 -->
                <TextBlock Text="证书指纹（SHA-256）" Style="{StaticResource Text.Caption}" Margin="0,18,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource Input.TextBox}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" Text="{Binding CertPin, Mode=OneWay}" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="获取指纹"
                            Margin="8,0,0,0" Command="{Binding FetchPinCommand}" />
                </Grid>

                <TextBlock Text="登录凭据" Style="{StaticResource Text.Caption}" Margin="0,18,0,6" />
                <ComboBox Style="{StaticResource Input.ComboBox}" DisplayMemberPath="Label"
                          ItemsSource="{Binding CredentialChoices}" SelectedItem="{Binding SelectedCredential}" />

                <Grid Margin="0,12,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsesNewCredential}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="用户名" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Input.TextBox}"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="密码" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                        <!-- PasswordBox 不参与数据绑定：明文只在点保存时由代码后置读取一次，不进入 ViewModel。 -->
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource Input.PasswordBox}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,16,0,0"
                           Style="{StaticResource Text.Caption}">
                    <TextBlock.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Resources>
                </TextBlock>
            </StackPanel>

            <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="0,0,11,11" Margin="0,24,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}" Content="取消" IsCancel="True" Click="OnCancelClick" />
                    <Button Style="{StaticResource Button.Primary}" Content="登录并保存" IsDefault="True" Margin="8,0,0,0"
                            IsEnabled="{Binding CanSaveNow}" Click="OnSaveClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
