<Window x:Class="RemoteFlow.App.Views.Dialogs.GroupNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Margin="28,26,28,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Folder}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="17"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brand.Default}" />
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource Text.SectionTitle}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="Collapsed" />

                <TextBlock Text="名称" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
                <TextBox x:Name="NameInput"
                         Style="{StaticResource Input.TextBox}"
                         MaxLength="60" />

                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Status.Danger}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <Border Background="{DynamicResource Bg.Subtle}"
                    CornerRadius="0,0,11,11"
                    Margin="0,24,0,0"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="取消"
                            IsCancel="True"
                            Click="OnCancelClick" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="确定"
                            IsDefault="True"
                            Margin="8,0,0,0"
                            Click="OnConfirmClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
