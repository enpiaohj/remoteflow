<Window x:Class="RemoteFlow.App.Views.Dialogs.TestConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
    </Window.Resources>

    <!-- 统一「测试连接」对话框：DNS / Ping / TCP 三步诊断 + 结论与折叠详情。
         与 GroupNameDialog / AboutDialog 共用同一自绘窗体壳。 -->
    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── 内容区 ── -->
            <StackPanel Grid.Row="0" Margin="28,26,28,0">

                <!-- 协议图标 + 名称 / Host:Port 两行 -->
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Border Width="44" Height="44" CornerRadius="8"
                                Background="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}"
                                Opacity="0.12" />
                        <TextBlock Width="44" Height="44"
                                   Text="{Binding ProtocolIcon}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="19"
                                   Foreground="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionName}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding HostPortLine}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 三步单行诊断 -->
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,20,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Glyph}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{Binding BrushKey, Converter={StaticResource KeyToBrush}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Label}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding StatusText}"
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 结论行 -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="{Binding HasConclusion, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ConclusionGlyph}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="14"
                               Foreground="{Binding ConclusionBrushKey, Converter={StaticResource KeyToBrush}}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConclusionText}"
                               Style="{StaticResource Text.Body}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 可能原因（仅失败时出现） -->
                <StackPanel Margin="28,10,0,0"
                            Visibility="{Binding HasCauses, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="可能原因" Style="{StaticResource Text.Caption}" />
                    <ItemsControl ItemsSource="{Binding Causes}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="·" Foreground="{DynamicResource Text.Tertiary}" FontSize="12" />
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource Text.Caption}"
                                               TextWrapping="Wrap"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ICMP 提示：TCP 可达但 Ping 超时时附带 -->
                <TextBlock Text="{Binding PingNote}"
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="28,8,0,0"
                           Visibility="{Binding HasPingNote, Converter={StaticResource BoolToVisibility}}" />

                <!-- 折叠详情 -->
                <Button Style="{StaticResource Button.Subtle}"
                        HorizontalAlignment="Left"
                        MinHeight="28"
                        Padding="8,4"
                        Margin="0,10,0,0"
                        Click="OnToggleDetailsClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DetailChevron}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="查看详细信息"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <ScrollViewer MaxHeight="170"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0"
                              Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{DynamicResource Bg.Subtle}"
                            BorderBrush="{DynamicResource Stroke.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <TextBlock Text="{Binding DetailsText}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" />
                    </Border>
                </ScrollViewer>
            </StackPanel>

            <!-- ── 底部按钮区：测试中「取消」；结束「重新测试 / 关闭」── -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Bg.Subtle}"
                    CornerRadius="0,0,11,11"
                    Margin="0,22,0,0"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="取消"
                            Margin="0,0,8,0"
                            Click="OnCancelClick"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="重新测试"
                            Margin="0,0,8,0"
                            Click="OnRetryClick"
                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="关闭"
                            IsDefault="True"
                            Click="OnCloseClick"
                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
