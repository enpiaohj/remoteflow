<Window x:Class="RemoteFlow.App.Views.Dialogs.ConnectionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
        xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
        xmlns:models="clr-namespace:RemoteFlow.Core.Models;assembly=RemoteFlow.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConnectionEditorViewModel}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="720"
        SizeToContent="Height"
        MaxHeight="880"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextElement.Foreground="{DynamicResource Text.Primary}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:ColorStringToBrushConverter x:Key="ColorToBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <!-- 协议选择项 -->
        <Style x:Key="ProtocolOption" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Protocol" />
            <!-- 控件自身 Foreground 默认是系统黑，会屏蔽 Window 级 TextElement.Foreground
                 的继承（深色主题下黑底黑字），必须在此显式跟随主题 -->
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Nav.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表单行：标签固定宽度，输入区自适应 -->
        <Style x:Key="FormRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 高级设置展开区的分区小标题（RDP / SSH / VNC 统一使用） -->
        <Style x:Key="RdpSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>

        <!--
            本对话框的 Focus Visual：鼠标点击不显示默认虚线，键盘 Tab 聚焦时
            显示轻量蓝色圆角环。只做对话框内收敛（样式在 Window.Resources 内），
            不扩散到全局。按钮 / 主按钮模板自带键盘焦点环，不重复叠加。
        -->
        <Style x:Key="Dialog.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource Input.CheckBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Nav.FocusVisual}" />
        </Style>
        <Style x:Key="Dialog.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource Input.ComboBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Nav.FocusVisual}" />
        </Style>
        <Style x:Key="Dialog.Segment" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Nav.FocusVisual}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.26" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="56" x:Name="TitleBar">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource Text.SectionTitle}"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
                <Button Style="{StaticResource Button.Icon}"
                        Content="{StaticResource Icon.Close}"
                        HorizontalAlignment="Right"
                        Margin="0,0,12,0"
                        IsCancel="True"
                        Click="OnCancelClick"
                        FocusVisualStyle="{x:Null}" />
            </Grid>

            <Border Grid.Row="0" Style="{StaticResource Surface.Divider}" VerticalAlignment="Bottom" />

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="152" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 协议选择 -->
                <StackPanel Grid.Column="0" Margin="12,16,6,16">
                    <TextBlock Text="协议" Style="{StaticResource Text.Label}" Margin="12,0,0,8" />

                    <RadioButton Style="{StaticResource ProtocolOption}"
                                 IsChecked="{Binding Protocol, Converter={StaticResource EnumToBool}, ConverterParameter=Rdp, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Rdp}" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Foreground="{DynamicResource Protocol.Rdp}" VerticalAlignment="Center" />
                            <TextBlock Text="RDP" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ProtocolOption}"
                                 IsChecked="{Binding Protocol, Converter={StaticResource EnumToBool}, ConverterParameter=Ssh, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Ssh}" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Foreground="{DynamicResource Protocol.Ssh}" VerticalAlignment="Center" />
                            <TextBlock Text="SSH" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ProtocolOption}"
                                 IsChecked="{Binding Protocol, Converter={StaticResource EnumToBool}, ConverterParameter=Vnc, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Vnc}" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Foreground="{DynamicResource Protocol.Vnc}" VerticalAlignment="Center" />
                            <TextBlock Text="VNC" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="12,14,6,0"
                               Text="VNC 也用于连接 macOS 的「屏幕共享」。" />
                </StackPanel>

                <Border Grid.Column="0" Width="1" HorizontalAlignment="Right"
                        Background="{DynamicResource Stroke.Subtle}" />

                <!-- 表单 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                    <StackPanel>

                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource Text.FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="NameBox"
                                     Style="{StaticResource Input.TextBox}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="主机 / IP" Style="{StaticResource Text.FieldLabel}" />
                            <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}"
                                     FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="3" Text="端口" Style="{StaticResource Text.FieldLabel}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="4" Style="{StaticResource Input.TextBox}"
                                     FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="凭据" Style="{StaticResource Text.FieldLabel}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Dialog.ComboBox}"
                                      ItemsSource="{Binding AvailableCredentials}"
                                      SelectedItem="{Binding SelectedCredential}"
                                      DisplayMemberPath="Name" />
                        </Grid>

                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="分组" Style="{StaticResource Text.FieldLabel}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Dialog.ComboBox}"
                                      ItemsSource="{Binding AvailableGroups}"
                                      SelectedItem="{Binding SelectedGroup}"
                                      DisplayMemberPath="Name" />
                        </Grid>

                        <!-- 标签行始终显示（哪怕一个标签都还没有）——否则用户永远找不到
                             新建标签的入口。右键任意标签芯片可编辑 / 删除；末尾的
                             「+ 管理标签」始终存在，点开完整的标签管理对话框。 -->
                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="标签" Style="{StaticResource Text.FieldLabel}" VerticalAlignment="Top" Margin="0,6,12,0" />
                            <WrapPanel Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding AvailableTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TagSelection}">
                                            <ToggleButton IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,6,6" Cursor="Hand"
                                                          FocusVisualStyle="{StaticResource Nav.FocusVisual}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Root" CornerRadius="4" Padding="9,4"
                                                                Background="{DynamicResource Bg.Subtle}"
                                                                BorderBrush="{DynamicResource Stroke.Default}"
                                                                BorderThickness="1">
                                                            <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="12"
                                                                       Foreground="{DynamicResource Text.Secondary}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Root" Property="Background"
                                                                        Value="{Binding Color, Converter={StaticResource ColorToBrush}}" />
                                                                <Setter TargetName="Root" Property="BorderBrush"
                                                                        Value="{Binding Color, Converter={StaticResource ColorToBrush}}" />
                                                                <Setter TargetName="Label" Property="Foreground" Value="White" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ 管理标签" Margin="0,0,6,6" Cursor="Hand"
                                        FocusVisualStyle="{StaticResource Nav.FocusVisual}"
                                        Click="OnManageTagsClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="4" Padding="9,4"
                                                    BorderBrush="{DynamicResource Stroke.Default}"
                                                    BorderThickness="1" Background="Transparent">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="12"
                                                           Foreground="{DynamicResource Text.Tertiary}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <Grid Style="{StaticResource FormRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="备注" Style="{StaticResource Text.FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,0" />
                            <TextBox Grid.Column="1" Style="{StaticResource Input.TextArea}" MinHeight="56"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- ══ 高级设置：默认收起，避免首屏暴露全部可配置项 ══ -->
                        <ToggleButton IsChecked="{Binding IsAdvancedExpanded}"
                                      HorizontalAlignment="Left"
                                      Margin="0,4,0,0"
                                      Cursor="Hand"
                                      FocusVisualStyle="{StaticResource Nav.FocusVisual}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chevron" Text="{StaticResource Icon.ChevronRight}"
                                                       FontFamily="{StaticResource IconFont}" FontSize="10"
                                                       Foreground="{DynamicResource Brand.Default}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="高级设置" FontSize="13"
                                                       Foreground="{DynamicResource Brand.Default}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="{StaticResource Icon.ChevronDown}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!--
                            高级设置展开区：去卡片化，与外部编辑表单同底色（不再垫一块浅灰底板），
                            层级只靠 Section Title + 很淡的 1px Divider + 组间留白。RDP / SSH / VNC
                            三套分区统一使用同一轻量视觉语言，功能字段与结构不变。
                        -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BoolToVisibility}}">

                            <!-- RDP 高级设置 -->
                            <StackPanel Visibility="{Binding IsRdp, Converter={StaticResource BoolToVisibility}}">

                                <!-- 显示 -->
                                <TextBlock Text="显示" Style="{StaticResource RdpSectionHeader}" />
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="显示模式" Style="{StaticResource Text.FieldLabel}"
                                               VerticalAlignment="Top" Margin="0,8,12,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Dialog.Segment}"
                                                     IsChecked="{Binding RdpDisplayMode, Converter={StaticResource EnumToBool}, ConverterParameter=FitToWindow, Mode=TwoWay}"
                                                     Content="适应窗口" />
                                        <RadioButton Style="{StaticResource Dialog.Segment}"
                                                     IsChecked="{Binding RdpDisplayMode, Converter={StaticResource EnumToBool}, ConverterParameter=FixedResolution, Mode=TwoWay}"
                                                     Content="固定分辨率" />
                                    </StackPanel>
                                </Grid>

                                <!-- 适应窗口 = 远程随会话自适应，分辨率行整体隐藏（不出现“仅固定生效”噪音） -->
                                <Grid Style="{StaticResource FormRow}"
                                      Visibility="{Binding IsFixedResolution, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="分辨率" Style="{StaticResource Text.FieldLabel}" />
                                    <StackPanel Grid.Column="1">
                                        <ComboBox Style="{StaticResource Dialog.ComboBox}"
                                                  ItemsSource="{Binding AvailableResolutions}"
                                                  SelectedItem="{Binding SelectedResolution}"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Left" MinWidth="220" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                                   Text="固定分辨率下按所选尺寸显示；超出窗口时提供滚动条。" />
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource FormRow}"
                                      Visibility="{Binding IsCustomResolution, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="自定义尺寸" Style="{StaticResource Text.FieldLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}"
                                             Text="{Binding RdpCustomWidth, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="×" Style="{StaticResource Text.BodySecondary}"
                                               HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="3" Style="{StaticResource Input.TextBox}"
                                             Text="{Binding RdpCustomHeight, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <CheckBox Style="{StaticResource Dialog.CheckBox}" Content="启动后进入全屏"
                                          IsChecked="{Binding RdpStartFullScreen}" />
                                <CheckBox Style="{StaticResource Dialog.CheckBox}" Content="使用全部显示器"
                                          IsChecked="{Binding RdpUseMultimon}" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Margin="28,-2,0,8"
                                           Visibility="{Binding UseMultimonHint, Converter={StaticResource NullToVisibility}}"
                                           Text="{Binding UseMultimonHint}" />

                                <Border Style="{StaticResource Surface.Divider}" Margin="0,4,0,14" />

                                <!-- 本地资源 -->
                                <TextBlock Text="本地资源" Style="{StaticResource RdpSectionHeader}" />
                                <CheckBox Style="{StaticResource Dialog.CheckBox}" Content="剪贴板重定向"
                                          IsChecked="{Binding Rdp.RedirectClipboard}" />
                                <CheckBox Style="{StaticResource Dialog.CheckBox}" Content="音频播放到本机"
                                          IsChecked="{Binding RdpRedirectAudio}" />
                                <CheckBox Style="{StaticResource Dialog.CheckBox}"
                                          IsChecked="{Binding RdpRedirectMicrophone}">
                                    <StackPanel>
                                        <TextBlock Text="麦克风重定向" Style="{StaticResource Text.Body}" />
                                        <TextBlock Text="需同时开启「音频播放到本机」，并依赖本机/远端支持 RDP 音频捕获"
                                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Dialog.CheckBox}" Content="打印机重定向"
                                          IsChecked="{Binding Rdp.RedirectPrinters}" />
                                <CheckBox Style="{StaticResource Dialog.CheckBox}"
                                          IsChecked="{Binding Rdp.RedirectDrives}">
                                    <StackPanel>
                                        <TextBlock Text="本地驱动器重定向" Style="{StaticResource Text.Body}" />
                                        <TextBlock Text="会把本机磁盘暴露给远程主机，仅在信任目标时开启"
                                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Surface.Divider}" Margin="0,4,0,14" />

                                <!-- 体验 -->
                                <TextBlock Text="体验" Style="{StaticResource RdpSectionHeader}" />
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="连接质量" Style="{StaticResource Text.FieldLabel}" />
                                    <StackPanel Grid.Column="1">
                                        <ComboBox Style="{StaticResource Dialog.ComboBox}"
                                                  ItemsSource="{Binding ConnectionQualityOptions}"
                                                  SelectedItem="{Binding SelectedConnectionQuality}"
                                                  DisplayMemberPath="Label"
                                                  HorizontalAlignment="Left" MinWidth="220" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                                   Text="把所选网络类型发给远端，远端据此调整画面体验；自动表示不主动指定。" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Surface.Divider}" Margin="0,4,0,14" />

                                <!-- 连接与安全 -->
                                <TextBlock Text="连接与安全" Style="{StaticResource RdpSectionHeader}" />
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="域" Style="{StaticResource Text.FieldLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}"
                                             Text="{Binding Rdp.Domain, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <CheckBox Style="{StaticResource Dialog.CheckBox}"
                                          IsChecked="{Binding Rdp.EnableNla}">
                                    <StackPanel>
                                        <TextBlock Text="启用网络级别身份验证（NLA）" Style="{StaticResource Text.Body}" />
                                        <TextBlock Text="建议保持开启；关闭会降低连接的安全性"
                                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>

                            <!-- SSH 高级设置 -->
                            <StackPanel Visibility="{Binding IsSsh, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="会话" Style="{StaticResource RdpSectionHeader}" />
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="终端类型" Style="{StaticResource Text.FieldLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource Dialog.ComboBox}"
                                              ItemsSource="{Binding TerminalTypeOptions}"
                                              SelectedItem="{Binding Ssh.TerminalType}" />
                                </Grid>
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="字符编码" Style="{StaticResource Text.FieldLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource Dialog.ComboBox}"
                                              ItemsSource="{Binding EncodingOptions}"
                                              SelectedItem="{Binding Ssh.Encoding}" />
                                </Grid>
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="KeepAlive" Style="{StaticResource Text.FieldLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}"
                                             Text="{Binding Ssh.KeepAliveSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="登录后执行" Style="{StaticResource Text.FieldLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}"
                                             FontFamily="{StaticResource MonoFont}"
                                             Text="{Binding Ssh.InitialCommand, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>

                            <!-- VNC 高级设置 -->
                            <StackPanel Visibility="{Binding IsVnc, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="会话" Style="{StaticResource RdpSectionHeader}" />
                                <CheckBox Style="{StaticResource Dialog.CheckBox}"
                                          IsChecked="{Binding Vnc.SharedConnection}">
                                    <StackPanel>
                                        <TextBlock Text="共享连接" Style="{StaticResource Text.Body}" />
                                        <TextBlock Text="允许其他客户端同时连接，不断开已有会话"
                                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Dialog.CheckBox}" Content="只读模式（不发送键盘鼠标）"
                                          IsChecked="{Binding Vnc.ViewOnly}" />
                                <CheckBox Style="{StaticResource Dialog.CheckBox}" Margin="0,8,0,0"
                                          IsChecked="{Binding Vnc.ClipboardToLocal}">
                                    <StackPanel>
                                        <TextBlock Text="剪贴板同步（远端 → 本机）" Style="{StaticResource Text.Body}" />
                                        <TextBlock Text="接收远端复制内容到本机剪贴板；发送暂不支持"
                                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>

                                <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource Icon.Warning}"
                                                   FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource Status.Warning}"
                                                   VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Margin="9,0,0,0" MaxWidth="380" HorizontalAlignment="Left"
                                                   Text="VNC 协议自身的加密能力有限，建议只在内网、VPN 或 SSH 隧道中使用，不要把 VNC 端口直接暴露到公网。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底部操作区 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Bg.Subtle}"
                    CornerRadius="0,0,11,11"
                    Padding="20,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{StaticResource Icon.Error}"
                                   FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource Status.Danger}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Status.Danger}"
                                   Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 按钮模板自带键盘焦点蓝环（IsKeyboardFocused），这里关掉系统默认虚线即可 -->
                        <Button Style="{StaticResource Button.Secondary}" Content="取消"
                                IsCancel="True" Click="OnCancelClick"
                                FocusVisualStyle="{x:Null}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="保存"
                                Margin="8,0,0,0" Click="OnSaveClick"
                                FocusVisualStyle="{x:Null}" />
                        <Button Style="{StaticResource Button.Primary}" Content="保存并连接"
                                MinWidth="104" Margin="8,0,0,0" IsDefault="True" Click="OnSaveAndConnectClick"
                                FocusVisualStyle="{x:Null}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
