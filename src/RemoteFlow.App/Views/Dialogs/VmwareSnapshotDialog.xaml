<Window x:Class="RemoteFlow.App.Views.Dialogs.VmwareSnapshotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextElement.Foreground="{DynamicResource Text.Primary}">

    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Margin="28,26,28,0">
                <TextBlock x:Name="TitleBar" Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />

                <!-- 快照列表 -->
                <Border Margin="0,16,0,0" Height="210" BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="1"
                        CornerRadius="8" Background="{DynamicResource Bg.Subtle}">
                    <Grid>
                        <ListBox Style="{StaticResource List.Plain}" ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CreatedText}" Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="这台虚拟机还没有快照"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource Button.Secondary}" Content="恢复到所选快照" Command="{Binding RevertCommand}" />
                    <Button Style="{StaticResource Button.Secondary}" Content="删除所选快照" Margin="8,0,0,0" Command="{Binding RemoveCommand}" />
                    <Button Style="{StaticResource Button.Secondary}" Content="刷新" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                </StackPanel>

                <!-- 创建 -->
                <TextBlock Text="创建新快照" Style="{StaticResource Text.Caption}" Margin="0,18,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource Input.TextBox}" MaxLength="80"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Style="{StaticResource Input.TextBox}" MaxLength="200"
                             Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="3" Style="{StaticResource Button.Primary}" Content="创建" Margin="8,0,0,0"
                            Command="{Binding CreateCommand}" />
                </Grid>
                <TextBlock Text="左侧填名称，右侧可选填说明。新快照不包含虚拟机内存。" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />

                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,14,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="0,0,11,11" Margin="0,20,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}" Content="关闭" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
