<Window x:Class="RemoteFlow.App.Views.Dialogs.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Margin="28,26,28,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Credential}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brand.Default}" />
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource Text.SectionTitle}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource Text.BodySecondary}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordInput" Grid.Column="0"
                                 Style="{StaticResource Input.PasswordBox}" />
                    <TextBox x:Name="PasswordReveal" Grid.Column="0"
                             Style="{StaticResource Input.TextBox}"
                             Visibility="Collapsed" />
                    <ToggleButton x:Name="RevealToggle" Grid.Column="1"
                                  Width="32" Height="32" Margin="6,0,0,0"
                                  Cursor="Hand" Background="Transparent" BorderThickness="0"
                                  ToolTip="显示 / 隐藏口令"
                                  Checked="OnRevealToggled" Unchecked="OnRevealToggled">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <TextBlock x:Name="Glyph" Text="{StaticResource Icon.Reveal}"
                                               FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Hide}" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brand.Default}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <TextBlock x:Name="ConfirmLabel"
                           Text="再次输入以确认"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,12,0,0"
                           Visibility="Collapsed" />
                <Grid x:Name="ConfirmRow" Margin="0,6,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ConfirmInput" Grid.Column="0"
                                 Style="{StaticResource Input.PasswordBox}" />
                    <TextBox x:Name="ConfirmReveal" Grid.Column="0"
                             Style="{StaticResource Input.TextBox}"
                             Visibility="Collapsed" />
                    <Border Grid.Column="1" Width="32" Margin="6,0,0,0" />
                </Grid>

                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Status.Danger}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <Border Background="{DynamicResource Bg.Subtle}"
                    CornerRadius="0,0,11,11"
                    Margin="0,24,0,0"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="取消"
                            IsCancel="True"
                            Click="OnCancelClick" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="确定"
                            IsDefault="True"
                            Margin="8,0,0,0"
                            Click="OnConfirmClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
