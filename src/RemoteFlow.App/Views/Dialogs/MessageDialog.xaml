<Window x:Class="RemoteFlow.App.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <!-- 自绘对话框：系统 MessageBox 无法跟随应用主题，且样式停留在旧版观感 -->
    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Margin="28,26,28,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IconGlyph"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="18"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource Text.SectionTitle}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource Text.BodySecondary}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"
                           VerticalAlignment="Top" />
            </StackPanel>

            <Border Background="{DynamicResource Bg.Subtle}"
                    CornerRadius="0,0,11,11"
                    Margin="0,26,0,0"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource Button.Secondary}"
                            Content="取消"
                            IsCancel="True"
                            Click="OnCancelClick" />
                    <!-- 次操作按钮：默认折叠，只有 ShowChoice 三选一路径才显示，
                         两按钮的 ShowConfirm / ShowMessage 路径完全不受影响。 -->
                    <Button x:Name="AltButton"
                            Style="{StaticResource Button.Secondary}"
                            Content="确定"
                            Visibility="Collapsed"
                            Margin="8,0,0,0"
                            Click="OnAltClick" />
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource Button.Primary}"
                            Content="确定"
                            IsDefault="True"
                            Margin="8,0,0,0"
                            Click="OnConfirmClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
