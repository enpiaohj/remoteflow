<Window x:Class="RemoteFlow.App.Views.Dialogs.ConnectionCredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextElement.Foreground="{DynamicResource Text.Primary}">

    <!-- 版式复刻 Windows 安全中心的凭据输入框（mstsc 同款）：
         顶部「图标 + 标题 + 关闭」、大标题、说明、用户名 / 密码、记住我的凭据、更多选项、灰底确认栏。 -->
    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <!-- 顶栏：可拖动 -->
            <Grid Margin="16,12,10,0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" Source="{StaticResource Id.Credential}" />
                <TextBlock Grid.Column="1" Text="RemoteFlow 安全中心" Style="{StaticResource Text.Caption}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="28" Height="28" FontSize="11"
                        Content="{StaticResource Ui.Close}" ToolTip="取消" Click="OnCancelClick" />
            </Grid>

            <StackPanel Margin="28,14,28,0">
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource Text.SectionTitle}"
                           FontSize="20" />

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource Text.BodySecondary}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <!-- 输入区：在「更多选项」里选了已保存的凭据时整体置灰 -->
                <StackPanel x:Name="InputsPanel">
                    <!-- 凭据只有账户名：账户名固定显示 -->
                    <TextBlock x:Name="AccountText"
                               Style="{StaticResource Text.Body}"
                               Margin="0,22,0,0"
                               Visibility="Collapsed" />

                    <StackPanel x:Name="UsernamePanel" Margin="0,20,0,0">
                        <TextBlock Text="用户名" Style="{StaticResource Text.Body}" />
                        <TextBox x:Name="UsernameInput" Style="{StaticResource Input.TextBox}" Margin="0,8,0,0"
                                 TextChanged="OnUsernameChanged" />
                    </StackPanel>

                    <TextBlock x:Name="PasswordLabel" Text="密码" Style="{StaticResource Text.Body}" Margin="0,16,0,0" />
                    <!-- 密码框与用户名框等长；眼睛图标叠在框内右侧，输入后才出现 -->
                    <Grid Margin="0,8,0,0">
                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource Input.PasswordBox}"
                                     PasswordChanged="OnPasswordChanged" />
                        <TextBox x:Name="PasswordReveal"
                                 Style="{StaticResource Input.TextBox}"
                                 Visibility="Collapsed"
                                 TextChanged="OnPasswordRevealChanged" />
                        <ToggleButton x:Name="RevealToggle"
                                      Width="28" Height="28" Margin="0,0,5,0"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Cursor="Hand" Background="Transparent" BorderThickness="0"
                                      Visibility="Collapsed"
                                      ToolTip="显示 / 隐藏密码"
                                      Checked="OnRevealToggled" Unchecked="OnRevealToggled">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <Path x:Name="Glyph" Style="{StaticResource UiIcon}" Data="{StaticResource Ui.Reveal}" Width="16" Height="16" Fill="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Ui.Hide}" />
                                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Brand.Default}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <!-- 账户名固定时，框下方再给出「域\用户」全称（与系统对话框一致） -->
                    <TextBlock x:Name="FullAccountText"
                               Style="{StaticResource Text.Body}"
                               Margin="0,14,0,0"
                               Visibility="Collapsed" />
                </StackPanel>

                <CheckBox x:Name="RememberCheck"
                          Style="{StaticResource Input.CheckBox}"
                          Content="记住我的凭据"
                          Margin="0,16,0,0"
                          Checked="OnRememberToggled" Unchecked="OnRememberToggled" />

                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Status.Danger}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="Collapsed" />

                <!-- 更多选项：展开后列出可直接选用的已保存凭据 -->
                <Button x:Name="MoreOptionsButton"
                        Content="更多选项"
                        Margin="0,16,0,0"
                        Padding="0,4"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Click="OnMoreOptionsClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource Brand.Default}"
                                       Padding="{TemplateBinding Padding}" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 展开「更多选项」且勾选了「记住我的凭据」时出现：凭据类型与名称（名称默认跟随用户名，可改），
                     位于账户列表上方 -->
                <StackPanel x:Name="RememberOptionsPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="凭据类型" Style="{StaticResource Text.Body}" />
                    <ComboBox x:Name="CredentialTypeCombo"
                              Style="{StaticResource Input.ComboBox}"
                              Margin="0,8,0,0"
                              DisplayMemberPath="Label" />
                    <TextBlock Text="凭据名称" Style="{StaticResource Text.Body}" Margin="0,14,0,0" />
                    <TextBox x:Name="CredentialNameInput"
                             Style="{StaticResource Input.TextBox}"
                             Margin="0,8,0,0"
                             TextChanged="OnCredentialNameChanged" />
                </StackPanel>

                <TextBlock x:Name="MoreListLabel" Text="选择账户" Style="{StaticResource Text.Body}"
                           Margin="0,16,0,0" Visibility="Collapsed" />
                <ListBox x:Name="MoreList"
                         Style="{StaticResource List.Plain}"
                         Margin="0,6,0,0"
                         MaxHeight="190"
                         Visibility="Collapsed"
                         SelectionChanged="OnMoreSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource List.Row}">
                            <Setter Property="MinHeight" Value="52" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" Source="{StaticResource Id.Credential}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- 灰底确认栏：两个等宽按钮 -->
            <Border Background="{DynamicResource Bg.Subtle}"
                    CornerRadius="0,0,11,11"
                    Margin="0,22,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource Button.Primary}"
                            Content="确定"
                            IsDefault="True"
                            Margin="0,0,4,0"
                            Click="OnConfirmClick" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}"
                            Content="取消"
                            IsCancel="True"
                            Margin="4,0,0,0"
                            Click="OnCancelClick" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
