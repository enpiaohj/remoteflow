<UserControl x:Class="RemoteFlow.App.Views.Pages.ConnectionDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionsPageViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <conv:ColorStringToBrushConverter x:Key="ColorToBrush" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:RatioToHeightConverter x:Key="RatioToHeight" />

        <!-- 详情面板的字段行：标签在左、值在右，保持稳定的视觉节奏 -->
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- 分区的轻量小标题：小字号 + 次级灰，不喧宾夺主 -->
        <Style x:Key="Detail.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Margin" Value="0,2,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 未选中任何连接时的占位说明 -->
        <StackPanel VerticalAlignment="Center" Margin="24">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border Width="52" Height="52" CornerRadius="26"
                    Background="{DynamicResource Bg.Subtle}"
                    BorderBrush="{DynamicResource Stroke.Subtle}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <TextBlock Text="{StaticResource Icon.Connections}"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="21"
                           Foreground="{DynamicResource Text.Tertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="未选择连接"
                       Style="{StaticResource Text.Body}"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0" />
            <TextBlock Text="在左侧列表中选中一条连接，这里会显示它的主机、凭据与连接历史。"
                       Style="{StaticResource Text.Caption}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <!-- 详情内容：顶部固定核心操作区，下方信息/活动滚动 -->
        <Grid Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── 固定顶部：协议图标 / 名称 / 收藏 / 状态 / 连接 / 编辑 ── -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource Stroke.Subtle}"
                    BorderThickness="0,0,0,1"
                    Padding="20,16,20,14">
                <StackPanel DataContext="{Binding SelectedItem}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 图标系统标准尺寸（44）。首页大卡片与收藏/活动行继续用，此处保留 -->
                        <Border Grid.Column="0" Style="{StaticResource IconTile.Background}"
                                Background="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}"
                                Opacity="{StaticResource IconTile.ColorBgOpacity}" />
                        <TextBlock Grid.Column="0" Style="{StaticResource IconTile.Glyph}"
                                   Text="{Binding ProtocolIcon}"
                                   Foreground="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="12,0,8,0" />

                        <Button Grid.Column="2"
                                Width="30" Height="30"
                                FontSize="14"
                                ToolTip="收藏 / 取消收藏"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                    <Setter Property="Content" Value="{StaticResource Icon.Favorite}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Content" Value="{StaticResource Icon.FavoriteFilled}" />
                                            <Setter Property="Foreground" Value="#F2C037" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 连接状态：未连接 / 正在连接 / 已连接 / 连接失败 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding DataContext.SelectedConnectionStatusBrushKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource KeyToBrush}}" />
                        <TextBlock Text="{Binding DataContext.SelectedConnectionStatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 主操作：连接。编辑 / 复制 IP / Ping 在下方快捷动作区 -->
                    <Grid Margin="0,12,0,0">
                        <Button Grid.Column="0"
                                Style="{StaticResource Button.Primary}"
                                Content="连接"
                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </Grid>

                    <!-- 快捷动作区：编辑 / 复制 IP / Ping（三步诊断） -->
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <UniformGrid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                <Setter Property="MinHeight" Value="30" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </UniformGrid.Resources>
                        <Button ToolTip="编辑连接"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Edit}" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="编辑" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="复制主机 / IP"
                                Click="OnCopyHostClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Copy}" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="复制 IP" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0" ToolTip="测试连接：DNS → Ping → TCP 三步诊断"
                                Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Refresh}" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="Ping" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ── 滚动信息区 ── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,20,24" DataContext="{Binding SelectedItem}">

                    <!-- 连接信息 -->
                    <TextBlock Text="连接信息" Style="{StaticResource Detail.SectionTitle}" />

                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="主机" Style="{StaticResource Text.Label}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding HostDisplay}"
                                       Style="{StaticResource Text.Body}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Width="26" Height="26" Margin="8,0,0,0"
                                    Style="{StaticResource Button.Icon}" FontSize="12"
                                    Content="{StaticResource Icon.Copy}"
                                    ToolTip="复制主机 / IP"
                                    Click="OnCopyHostClick" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="端口" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding PortDisplay}" Style="{StaticResource Text.Body}" />
                    </Grid>

                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="协议" Style="{StaticResource Text.Label}" />
                        <!-- 协议色小徽章：与列表 / 首页同一套视觉语言 -->
                        <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border CornerRadius="4"
                                    Background="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}"
                                    Opacity="0.14" />
                            <TextBlock Text="{Binding ProtocolName}" FontSize="11" FontWeight="SemiBold" Margin="8,3"
                                       Foreground="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}" />
                        </Grid>
                    </Grid>

                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="分组" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding GroupName}" Style="{StaticResource Text.Body}" />
                    </Grid>

                    <Grid Style="{StaticResource FieldRow}"
                          Visibility="{Binding Tags.Count, Converter={StaticResource CountToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="标签" Style="{StaticResource Text.Label}" VerticalAlignment="Top" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5" Margin="0,0,5,5"
                                            Background="{DynamicResource Bg.Subtle}"
                                            BorderBrush="{DynamicResource Stroke.Subtle}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Margin="6,3">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{Binding Color, Converter={StaticResource ColorToBrush}}" />
                                            <TextBlock Text="{Binding Name}" FontSize="11" Margin="5,0,1,0"
                                                       Foreground="{DynamicResource Text.Secondary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 凭据只显示名称。界面在任何情况下都不呈现密码或私钥。 -->
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="凭据" Style="{StaticResource Text.Label}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Credential}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CredentialName}"
                                       Style="{StaticResource Text.Body}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 备注保留，仅显示时有行；放在「连接信息」末尾 -->
                    <Grid Style="{StaticResource FieldRow}"
                          Visibility="{Binding Notes.Length, Converter={StaticResource CountToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="备注" Style="{StaticResource Text.Label}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Notes}"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <Border Style="{StaticResource Surface.Divider}" Margin="0,4,0,18" />

                    <!-- 使用信息 -->
                    <TextBlock Text="使用信息" Style="{StaticResource Detail.SectionTitle}" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="创建时间" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}" Style="{StaticResource Text.Caption}" />
                    </Grid>

                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最近连接" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DataContext.SelectedLastConnectedText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Style="{StaticResource Text.Caption}" />
                    </Grid>

                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="上次时长" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DataContext.SelectedLastDurationText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Style="{StaticResource Text.Caption}" />
                    </Grid>

                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="连接次数" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DataContext.SelectedTotalConnectionsText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Style="{StaticResource Text.Caption}" />
                    </Grid>

                    <Border Style="{StaticResource Surface.Divider}" Margin="0,14,0,18" />

                    <!-- 连接活动：趋势 + 历史（有数据时展示图与列表，链接常显） -->
                    <TextBlock Text="连接活动" Style="{StaticResource Detail.SectionTitle}" />

                    <TextBlock Text="最近 10 次连接" Style="{StaticResource Text.Label}" Margin="0,0,0,10"
                               Visibility="{Binding DataContext.SelectedItemHasHistory, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                    <Border Background="{DynamicResource Bg.Subtle}"
                            BorderBrush="{DynamicResource Stroke.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Padding="12,10"
                            Margin="0,0,0,4"
                            Visibility="{Binding DataContext.SelectedItemHasHistory, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Border Height="1" VerticalAlignment="Bottom"
                                    Background="{DynamicResource Stroke.Default}" />
                            <ItemsControl Height="44"
                                          ItemsSource="{Binding DataContext.SelectedItemSparkline, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="14" Margin="0,0,5,0" VerticalAlignment="Bottom"
                                                CornerRadius="3,3,0,0" MinHeight="4"
                                                Height="{Binding Height, Converter={StaticResource RatioToHeight}, ConverterParameter=40}"
                                                Background="{Binding BrushKey, Converter={StaticResource KeyToBrush}}"
                                                ToolTip="{Binding Tooltip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <TextBlock Text="连接历史" Style="{StaticResource Text.Label}" Margin="0,14,0,8"
                               Visibility="{Binding DataContext.SelectedItemHasHistory, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding DataContext.SelectedItemHistory, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  MaxHeight="240"
                                  Visibility="{Binding DataContext.SelectedItemHasHistory, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{Binding ResultBrushKey, Converter={StaticResource KeyToBrush}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding StartedAtDisplay}" Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="还没有连接历史。连接成功后这里会显示最近记录。"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,0,0,4"
                               Visibility="{Binding DataContext.SelectedItemHasHistory, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Button Style="{StaticResource Button.Subtle}"
                            HorizontalAlignment="Left"
                            MinHeight="28"
                            Padding="10,0"
                            FontSize="12"
                            Margin="0,10,0,0"
                            Content="查看全部历史"
                            Command="{Binding DataContext.ViewAllHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
