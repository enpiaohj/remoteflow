<UserControl x:Class="RemoteFlow.App.Views.Pages.ConnectionDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionsPageViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <conv:ColorStringToBrushConverter x:Key="ColorToBrush" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:RatioToHeightConverter x:Key="RatioToHeight" />

        <!-- 详情面板的字段行：标签在左、值在右，保持稳定的视觉节奏 -->
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 未选中任何连接时的占位说明 -->
        <StackPanel VerticalAlignment="Center" Margin="24">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border Width="52" Height="52" CornerRadius="26"
                    Background="{DynamicResource Bg.Subtle}"
                    BorderBrush="{DynamicResource Stroke.Subtle}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <TextBlock Text="{StaticResource Icon.Connections}"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="21"
                           Foreground="{DynamicResource Text.Tertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="未选择连接"
                       Style="{StaticResource Text.Body}"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0" />
            <TextBlock Text="在左侧列表中选中一条连接，这里会显示它的主机、凭据与连接历史。"
                       Style="{StaticResource Text.Caption}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <!-- 详情内容 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
            <StackPanel Margin="20,20,20,24" DataContext="{Binding SelectedItem}">

                <!-- 标题区 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                            Background="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}"
                            Opacity="0.16" />
                    <TextBlock Grid.Column="0"
                               Text="{Binding ProtocolIcon}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="18"
                               Width="38"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               Style="{StaticResource Text.SectionTitle}"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0" />

                    <Button Grid.Column="2"
                            Width="30" Height="30"
                            FontSize="14"
                            ToolTip="收藏 / 取消收藏"
                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                <Setter Property="Content" Value="{StaticResource Icon.Favorite}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Content" Value="{StaticResource Icon.FavoriteFilled}" />
                                        <Setter Property="Foreground" Value="#F2C037" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 主操作 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource Button.Primary}"
                            Content="连接"
                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />

                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Secondary}"
                            MinWidth="40"
                            Margin="8,0,0,0"
                            Padding="0"
                            FontFamily="{StaticResource IconFont}"
                            Content="{StaticResource Icon.Edit}"
                            ToolTip="编辑连接"
                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>

                <Border Style="{StaticResource Surface.Divider}" Margin="0,0,0,18" />

                <!-- 字段列表 -->
                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="主机" Style="{StaticResource Text.Label}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding HostDisplay}"
                               Style="{StaticResource Text.Body}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="协议" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding ProtocolName}" Style="{StaticResource Text.Body}" />
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="分组" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding GroupName}" Style="{StaticResource Text.Body}" />
                </Grid>

                <Grid Style="{StaticResource FieldRow}"
                      Visibility="{Binding Tags.Count, Converter={StaticResource CountToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="标签" Style="{StaticResource Text.Label}" VerticalAlignment="Top" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Margin="0,0,5,5"
                                        Background="{DynamicResource Bg.Subtle}"
                                        BorderBrush="{DynamicResource Stroke.Subtle}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Margin="6,3">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={StaticResource ColorToBrush}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="5,0,1,0"
                                                   Foreground="{DynamicResource Text.Secondary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 凭据只显示名称。界面在任何情况下都不呈现密码或私钥。 -->
                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="凭据" Style="{StaticResource Text.Label}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Credential}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CredentialName}"
                                   Style="{StaticResource Text.Body}"
                                   Margin="7,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource FieldRow}"
                      Visibility="{Binding Notes.Length, Converter={StaticResource CountToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="备注" Style="{StaticResource Text.Label}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding Notes}"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top" />
                </Grid>

                <Border Style="{StaticResource Surface.Divider}" Margin="0,4,0,16" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="创建时间" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding CreatedAtDisplay}" Style="{StaticResource Text.Caption}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="最近连接" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding LastConnectedDisplay}" Style="{StaticResource Text.Caption}" />
                </Grid>

                <!-- ── 迷你图表 + 连接历史（数据来自页面 VM，非当前行 VM）── -->
                <StackPanel Margin="0,4,0,0"
                            Visibility="{Binding DataContext.SelectedItemHasHistory, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">

                    <Border Style="{StaticResource Surface.Divider}" Margin="0,14,0,16" />

                    <TextBlock Text="最近 10 次连接" Style="{StaticResource Text.Label}" Margin="0,0,0,10" />
                    <!-- 柱状图放进一块带底纹的图表区：条目少时也是一张完整的图，
                         而不是两根孤零零悬空的柱子。 -->
                    <Border Background="{DynamicResource Bg.Subtle}"
                            BorderBrush="{DynamicResource Stroke.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Medium}"
                            Padding="12,10">
                        <Grid>
                            <Border Height="1" VerticalAlignment="Bottom"
                                    Background="{DynamicResource Stroke.Default}" />
                            <ItemsControl Height="44"
                                          ItemsSource="{Binding DataContext.SelectedItemSparkline, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="14" Margin="0,0,5,0" VerticalAlignment="Bottom"
                                                CornerRadius="3,3,0,0" MinHeight="4"
                                                Height="{Binding Height, Converter={StaticResource RatioToHeight}, ConverterParameter=40}"
                                                Background="{Binding BrushKey, Converter={StaticResource KeyToBrush}}"
                                                ToolTip="{Binding Tooltip}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Surface.Divider}" Margin="0,16,0,14" />

                    <TextBlock Text="连接历史" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding DataContext.SelectedItemHistory, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  MaxHeight="240">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{Binding ResultBrushKey, Converter={StaticResource KeyToBrush}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding StartedAtDisplay}" Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
