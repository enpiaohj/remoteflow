<UserControl x:Class="RemoteFlow.App.Views.Pages.ImportExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ImportExportPageViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="导入 / 导出" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,20" />

            <!-- 导出 -->
            <Border Style="{StaticResource Surface.Card}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="导出连接列表" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Style="{StaticResource Text.BodySecondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="把全部连接导出为 CSV，便于备份或迁移到其他机器。文件使用 UTF-8 BOM 编码，可直接用 Excel 打开。" />

                        <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="6" Padding="12,9" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Shield}"
                                           FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource Status.Success}"
                                           VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="9,0,0,0"
                                           Text="导出文件不包含任何密码或私钥，只写入凭据名称用于人工核对。迁移后需要在新机器上重新录入凭据。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Secondary}"
                            Content="导出 CSV"
                            VerticalAlignment="Top"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Command="{Binding ExportCommand}" />
                </Grid>
            </Border>

            <!-- 导入 -->
            <Border Style="{StaticResource Surface.Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="导入连接列表" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Style="{StaticResource Text.BodySecondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="从 CSV 批量导入连接。缺失的分组与标签会自动创建；CredentialName 只用于关联已存在的凭据。" />

                        <TextBlock Text="列格式" Style="{StaticResource Text.Caption}" Margin="0,14,0,6" />
                        <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="6" Padding="12,10">
                            <TextBlock FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="Name,Host,Port,Protocol,Group,Tags,CredentialName,Notes" />
                        </Border>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Protocol 取值 Rdp / Ssh / Vnc；Tags 用分号分隔；Port 留空时按协议自动填入默认端口。" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Primary}"
                            Content="导入 CSV"
                            VerticalAlignment="Top"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Command="{Binding ImportCommand}" />
                </Grid>
            </Border>

            <!-- 导入结果 -->
            <Border Style="{StaticResource Surface.Card}" Padding="20" Margin="0,16,0,0"
                    Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="导入提示" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ImportMessages}" MaxHeight="260">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{StaticResource Icon.Warning}"
                                               FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="{DynamicResource Status.Warning}"
                                               VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}"
                                               TextWrapping="Wrap" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,14,0,0"
                       Visibility="{Binding StatusMessage.Length, Converter={StaticResource CountToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
