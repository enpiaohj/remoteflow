<UserControl x:Class="RemoteFlow.App.Views.Pages.CredentialsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CredentialsPageViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <ContextMenu x:Key="CredentialRowMenu" x:Shared="False">
            <MenuItem Header="编辑" Click="OnEditMenuClick" />
            <Separator />
            <MenuItem Header="删除" Click="OnDeleteMenuClick" />
        </ContextMenu>

        <Style x:Key="CredentialRow" TargetType="ListBoxItem" BasedOn="{StaticResource List.Row}">
            <Setter Property="ContextMenu" Value="{StaticResource CredentialRowMenu}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="凭据" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Icon}"
                        Content="{StaticResource Icon.Refresh}"
                        ToolTip="刷新"
                        Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource Button.Primary}"
                        MinHeight="32"
                        Padding="14,0"
                        Margin="8,0,0,0"
                        Command="{Binding CreateCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Add}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="新建凭据" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 安全说明：让用户明确知道 Secret 存在哪、以什么方式保护 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brand.Subtle}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="14,10"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{StaticResource Icon.Shield}"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="14"
                           Foreground="{DynamicResource Brand.Default}"
                           VerticalAlignment="Top"
                           Margin="0,1,0,0" />
                <TextBlock Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="10,0,0,0"
                           MaxWidth="820"
                           HorizontalAlignment="Left"
                           Text="密码与私钥由 Windows DPAPI 加密后保存在独立的保险库文件中，不写入连接数据库，也不随导出文件带走。界面不会显示任何已保存的 Secret 明文。" />
            </StackPanel>
        </Border>

        <!-- 列头 -->
        <Grid Grid.Row="2" Height="30" Margin="4,0"
              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource Text.Caption}" Margin="34,0,0,0" />
            <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource Text.Caption}" />
            <TextBlock Grid.Column="2" Text="用户名" Style="{StaticResource Text.Caption}" />
            <TextBlock Grid.Column="3" Text="保险库状态" Style="{StaticResource Text.Caption}" />
            <TextBlock Grid.Column="4" Text="被引用" Style="{StaticResource Text.Caption}" />
        </Grid>

        <Grid Grid.Row="3">
            <ListBox Style="{StaticResource List.Plain}"
                     ItemContainerStyle="{StaticResource CredentialRow}"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     Margin="0,4,0,0"
                     Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CredentialItemViewModel}">
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TypeIcon}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="13"
                                           Width="24"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Margin="10,0,8,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding TypeName}" Style="{StaticResource Text.BodySecondary}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{Binding Username}" Style="{StaticResource Text.BodySecondary}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            <TextBlock Grid.Column="3" Text="{Binding SecretStateDisplay}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Grid.Column="4" Text="{Binding UsageDisplay}" Style="{StaticResource Text.Caption}" />

                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Button.Icon}"
                                        Width="30" Height="30" FontSize="13"
                                        Content="{StaticResource Icon.Edit}"
                                        ToolTip="编辑"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource Button.Icon}"
                                        Width="30" Height="30" FontSize="13"
                                        Content="{StaticResource Icon.Delete}"
                                        ToolTip="删除"
                                        Foreground="{DynamicResource Status.Danger}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Bg.Subtle}" HorizontalAlignment="Center">
                    <TextBlock Text="{StaticResource Icon.Credential}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="24"
                               Foreground="{DynamicResource Text.Tertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Style="{StaticResource Text.BodySecondary}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"
                           Text="还没有凭据。把常用账号建成凭据后，多台主机可以共用同一份账号信息，改密时只需更新一次。" />
                <Button Style="{StaticResource Button.Primary}" Content="新建凭据"
                        HorizontalAlignment="Center" Margin="0,20,0,0"
                        Command="{Binding CreateCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
