<UserControl x:Class="RemoteFlow.App.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomePageViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />

        <!-- 连接快捷卡片。首页用卡片而非表格，因为这里的目标是「一眼认出并点开」 -->
        <DataTemplate x:Key="ConnectionCard" DataType="{x:Type vm:ConnectionItemViewModel}">
            <Button Width="228" Height="76" Margin="0,0,12,12"
                    Cursor="Hand"
                    Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{DynamicResource Bg.Layer}"
                                BorderBrush="{DynamicResource Stroke.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Large}"
                                Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Stroke.Default}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.RowSpan="2" Width="30" Height="30" VerticalAlignment="Top">
                        <Border CornerRadius="7"
                                Background="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}"
                                Opacity="0.16" />
                        <TextBlock Text="{Binding ProtocolIcon}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}" />
                    </Grid>

                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Text="{Binding Name}"
                               Style="{StaticResource Text.Body}"
                               FontWeight="SemiBold"
                               Margin="12,0,0,0"
                               HorizontalAlignment="Left" />

                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="12,3,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding HostDisplay}"
                                   Style="{StaticResource Text.Caption}"
                                   FontFamily="{StaticResource MonoFont}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding LastConnectedDisplay}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- 问候语 -->
            <TextBlock Style="{StaticResource Text.PageTitle}" Margin="0,0,0,4">
                <Run Text="{Binding Greeting, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.BodySecondary}" Margin="0,0,0,24">
                <Run Text="共" />
                <Run Text="{Binding TotalConnections, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="个连接 ·" />
                <Run Text="{Binding ActiveSessions, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="个会话进行中" />
            </TextBlock>

            <!-- 首次使用引导 -->
            <Border Style="{StaticResource Surface.Card}"
                    Padding="24"
                    Margin="0,0,0,24"
                    Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="欢迎使用 RemoteFlow" Style="{StaticResource Text.SectionTitle}" />
                    <TextBlock Style="{StaticResource Text.BodySecondary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="把 RDP、SSH、VNC 连接统一到一个工作台。先创建一个连接，或从 CSV 导入既有的服务器清单。" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Text="密码与私钥由 Windows DPAPI 加密后单独保存，不会写入连接数据库，也不会随导出文件带走。" />
                </StackPanel>
            </Border>

            <!-- 最近连接 -->
            <StackPanel Margin="0,0,0,8" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="最近连接" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding RecentItems}" ItemTemplate="{StaticResource ConnectionCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- 收藏 -->
            <StackPanel Margin="0,12,0,8" Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="收藏" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding FavoriteItems}" ItemTemplate="{StaticResource ConnectionCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- 连接历史 -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding RecentHistory.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="连接历史" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                <Border Style="{StaticResource Surface.Card}" Padding="4">
                    <ItemsControl ItemsSource="{Binding RecentHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                                <Grid Height="38" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ResultIcon}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding ResultBrushKey, Converter={StaticResource KeyToBrush}}"
                                               ToolTip="{Binding ResultText}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ConnectionName}"
                                               Style="{StaticResource Text.Body}"
                                               Margin="8,0,0,0"
                                               MaxWidth="220"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Host}"
                                               Style="{StaticResource Text.Caption}"
                                               FontFamily="{StaticResource MonoFont}"
                                               Margin="12,0,0,0"
                                               MaxWidth="240"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ProtocolName}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding StartedAtDisplay}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="16,0,0,0" />
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding DurationDisplay}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="16,0,0,0"
                                               MinWidth="56"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
