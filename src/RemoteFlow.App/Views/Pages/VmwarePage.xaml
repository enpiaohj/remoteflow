<UserControl x:Class="RemoteFlow.App.Views.Pages.VmwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RemoteFlow.App.Views"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VmwarePageViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBoolToBool" />

        <!-- 虚拟机行里的「电源」菜单。Tag 对应 VmwarePage.xaml.cs 里的动作；危险操作放最后一组并用警示色。 -->
        <ContextMenu x:Key="PowerMenu" x:Shared="False" Opened="OnPowerMenuOpened">
            <MenuItem Tag="poweron" Header="开机" Click="OnPowerMenuClick" />
            <Separator />
            <MenuItem Tag="shutdown" Header="正常关机" Click="OnPowerMenuClick" />
            <MenuItem Tag="reboot" Header="正常重启" Click="OnPowerMenuClick" />
            <MenuItem Tag="suspend" Header="挂起" Click="OnPowerMenuClick" />
            <Separator />
            <MenuItem Tag="poweroff" Header="强制断电…" views:MenuItemAssist.IsDanger="True" Click="OnPowerMenuClick" />
            <MenuItem Tag="reset" Header="强制重置…" views:MenuItemAssist.IsDanger="True" Click="OnPowerMenuClick" />
        </ContextMenu>

        <Style x:Key="Vmware.StatusText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Status.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="虚拟化" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,0"
                           Text="管理 ESXi 主机和 vCenter，在 RemoteFlow 里直接打开虚拟机控制台，并执行电源与快照操作。" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="添加 ESXi / vCenter"
                    VerticalAlignment="Center" Command="{Binding AddSourceCommand}" />
        </Grid>

        <!-- 还没有来源 -->
        <Border Grid.Row="1" Style="{StaticResource Surface.Card}"
                Visibility="{Binding ShowEmptySources, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock Text="还没有添加 ESXi 主机或 vCenter" Style="{StaticResource Text.SectionTitle}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.BodySecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                           Text="添加后，这里会实时列出其下的虚拟机，可以直接打开控制台、开关机和管理快照。虚拟机不会保存在连接列表里，也不会和你已有的 RDP / SSH 连接重复。" />
                <Button Style="{StaticResource Button.Primary}" Content="添加 ESXi / vCenter" HorizontalAlignment="Center"
                        Margin="0,20,0,0" Command="{Binding AddSourceCommand}" />
            </StackPanel>
        </Border>

        <!-- 来源 + 虚拟机 -->
        <Grid Grid.Row="1" Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：来源 -->
            <Border Style="{StaticResource Surface.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="来源" Style="{StaticResource Text.SectionTitle}" Margin="16,14,16,8" />
                    <ListBox Grid.Row="1" Style="{StaticResource List.Plain}" ItemsSource="{Binding Sources}"
                             SelectedItem="{Binding SelectedSource}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="12,8">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text="　·　" /><Run Text="{Binding Address, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,8,12,12">
                        <Button Style="{StaticResource Button.Secondary}" Content="编辑" Command="{Binding EditSourceCommand}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="删除" Margin="8,0,0,0" Command="{Binding DeleteSourceCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：虚拟机 -->
            <Border Grid.Column="2" Style="{StaticResource Surface.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,14,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Input.TextBox}" ToolTip="按虚拟机名称搜索"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="刷新" Command="{Binding RefreshCommand}" />
                        <TextBlock Grid.Column="4" Text="{Binding StatusText}" Style="{StaticResource Vmware.StatusText}"
                                   VerticalAlignment="Center" ToolTip="{Binding StatusText}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="VmList" Style="{StaticResource List.Plain}" ItemsSource="{Binding Vms}"
                                 BorderThickness="0" Background="Transparent" MouseDoubleClick="OnVmDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,6" MinHeight="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding PowerGlyph, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding PowerText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToBool}}">
                                            <Button Style="{StaticResource Button.Secondary}" Content="控制台" Click="OnConsoleClick"
                                                    IsEnabled="{Binding CanOpenConsole}" />
                                            <Button Style="{StaticResource Button.Secondary}" Content="电源 ▾" Margin="8,0,0,0" Click="OnPowerButtonClick" />
                                            <Button Style="{StaticResource Button.Secondary}" Content="快照" Margin="8,0,0,0" Click="OnSnapshotsClick" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="该来源下没有虚拟机" Style="{StaticResource Text.BodySecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowNoVms, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
