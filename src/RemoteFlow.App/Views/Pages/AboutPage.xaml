<UserControl x:Class="RemoteFlow.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:RemoteFlow.App.Views.Pages"
             xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutPageViewModel}">

    <!-- 独立的关于页：正文已抽成 AboutContent（设置页「关于」选项卡共用）。
         应用内「关于」入口统一跳到 设置 → 关于；本页保留给直接承载 AboutPageViewModel 的场景。 -->
    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="关于" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="版本、许可与数据合规说明。"
                       Style="{StaticResource Text.BodySecondary}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,20">
            <pages:AboutContent HorizontalAlignment="Left" />
        </ScrollViewer>
    </Grid>
</UserControl>
