<UserControl x:Class="RemoteFlow.App.Views.Sessions.SessionToolsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SessionTabViewModel}"
             shell:WindowChrome.IsHitTestVisibleInChrome="True">

    <!-- 会话工具条：原会话视图内的常驻条，v0.19.1 起迁到标题栏行（Tab 条右侧），
         与标签条合并为浏览器式单行标题栏。DataContext = 选中的 SessionTabViewModel。 -->

    <UserControl.Resources>
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 文件传输开关：侧栏展开时用品牌色 -->
        <Style x:Key="FileTransferToggle" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFileTransferOpen}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brand.Default}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <!-- 地址与右侧按钮之间的固定间隔：工具条按内容收缩宽度，用 * 列时间隔会被压成 0，按钮贴到地址上 -->
            <ColumnDefinition Width="*" MinWidth="12" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 状态入口：点击打开连接质量详情 Flyout -->
        <StackPanel Grid.Column="0" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0">
            <Button Style="{StaticResource Button.Subtle}"
                    Height="30"
                    Padding="8,0"
                    Click="OnStatusEntryClick"
                    ToolTip="连接状态 · 查看质量详情">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource UiIcon}" Width="14" Height="14" Data="{Binding StateIconKey, Converter={StaticResource UiIconGeometry}}" Fill="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}" />
                    <TextBlock Text="{Binding StateText}"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center"
                               Margin="7,0,0,0" />
                </StackPanel>
            </Button>
            <Border Width="1" Height="16" Margin="10,0,0,0"
                    Background="{DynamicResource Stroke.Default}"
                    IsHitTestVisible="False" />
            <TextBlock Text="{Binding Profile.Host}"
                       Style="{StaticResource Text.Caption}"
                       FontFamily="{StaticResource MonoFont}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Margin="10,0,0,0"
                       MaxWidth="220"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Profile.Host}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 协议操作：每种会话最多常驻一个最常用的按钮，其余收进带文字的「更多」菜单（图标多了反而认不出） -->
            <StackPanel x:Name="RdpToolsDock" Orientation="Horizontal" Visibility="Collapsed">
                <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                        Content="{StaticResource Ui.More}"
                        ToolTip="更多会话操作"
                        AutomationProperties.Name="更多会话操作"
                        Tag="Rdp"
                        Click="OnMoreToolsClick"
                        FocusVisualStyle="{x:Null}" />
            </StackPanel>

            <StackPanel x:Name="SshToolsDock" Orientation="Horizontal" Visibility="Collapsed">
                <!-- 文件传输是开关（侧栏展开 / 收起），保持常驻，便于看出状态 -->
                <Button Style="{StaticResource FileTransferToggle}" Height="30" Width="30" FontSize="14"
                        Content="{StaticResource Ui.FileTransfer}"
                        ToolTip="文件传输（SFTP）"
                        Command="{Binding ToggleFileTransferCommand}"
                        Visibility="{Binding SupportsFileTransfer, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                        Content="{StaticResource Ui.More}"
                        ToolTip="更多会话操作"
                        AutomationProperties.Name="更多会话操作"
                        Tag="Ssh"
                        Click="OnMoreToolsClick"
                        FocusVisualStyle="{x:Null}" />
            </StackPanel>

            <StackPanel x:Name="VncToolsDock" Orientation="Horizontal" Visibility="Collapsed">
                <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                        Content="{StaticResource Ui.Scale}"
                        ToolTip="{Binding VncScalingLabel}"
                        Command="{Binding CycleVncScalingCommand}" />
                <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                        Content="{StaticResource Ui.More}"
                        ToolTip="更多会话操作"
                        AutomationProperties.Name="更多会话操作"
                        Tag="Vnc"
                        Click="OnMoreToolsClick"
                        FocusVisualStyle="{x:Null}" />
            </StackPanel>

            <Border Width="1" Height="16" Margin="6,0"
                    Background="{DynamicResource Stroke.Default}" />

            <!-- 窗口最大化档与完全全屏的切换入口（与 F11 等价） -->
            <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                    Content="{StaticResource Ui.WindowMaximize}"
                    ToolTip="窗口最大化（收起侧边，会话铺满窗口）"
                    Command="{Binding AdvanceFullScreenCommand}" />
            <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                    Content="{StaticResource Ui.FullScreen}"
                    ToolTip="完全全屏 (F11)"
                    Command="{Binding ToggleScreenFullCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
