<UserControl x:Class="RemoteFlow.App.Views.Sessions.SessionHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SessionTabViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource Bg.Session}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ 会话工具条 ══════════════════════════════════════════
             只保留当前协议真正需要的操作；低频项收进「更多」。 -->
        <Border Grid.Row="0"
                x:Name="Toolbar"
                Height="38"
                Background="{DynamicResource Bg.Layer}"
                BorderBrush="{DynamicResource Stroke.Subtle}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 连接状态：图标 + 文字同时呈现，不单靠颜色传达 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateIcon}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}" />
                    <TextBlock Text="{Binding StateText}"
                               Style="{StaticResource Text.Caption}"
                               Margin="7,0,0,0" />
                    <Border Width="1" Height="16" Margin="12,0"
                            Background="{DynamicResource Stroke.Default}" />
                    <TextBlock Text="{Binding Profile.Host}"
                               Style="{StaticResource Text.Caption}"
                               FontFamily="{StaticResource MonoFont}" />
                </StackPanel>

                <!-- 协议专属操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <!-- RDP -->
                    <StackPanel x:Name="RdpTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                                Content="{StaticResource Icon.Scale}"
                                ToolTip="缩放 / 适应窗口"
                                Command="{Binding ToggleScalingCommand}" />
                        <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                                Content="{StaticResource Icon.Keyboard}"
                                ToolTip="发送 Ctrl+Alt+Del"
                                Command="{Binding SendCtrlAltDeleteCommand}" />
                    </StackPanel>

                    <!-- SSH -->
                    <StackPanel x:Name="SshTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                                Content="{StaticResource Icon.Copy}"
                                ToolTip="复制选中内容 (Ctrl+Shift+C)"
                                Command="{Binding CopySelectionCommand}" />
                        <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                                Content="{StaticResource Icon.Paste}"
                                ToolTip="粘贴 (Ctrl+Shift+V)"
                                Command="{Binding PasteClipboardCommand}" />
                    </StackPanel>

                    <!-- VNC -->
                    <StackPanel x:Name="VncTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                                Content="{StaticResource Icon.Scale}"
                                ToolTip="适应窗口 / 1:1"
                                Command="{Binding ToggleScalingCommand}" />
                    </StackPanel>

                    <Border Width="1" Height="16" Margin="6,0"
                            Background="{DynamicResource Stroke.Default}" />

                    <Button Style="{StaticResource Button.Icon}" Height="30" Width="30" FontSize="14"
                            Content="{StaticResource Icon.FullScreen}"
                            ToolTip="全屏 (F11)"
                            Command="{Binding ToggleFullScreenCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 会话内容 ═════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <!-- 协议视图由代码后置按会话类型注入；必须拉伸填满，否则全屏后
                 RDP/VNC 画面会缩在左上角、四周留黑边。 -->
            <ContentControl x:Name="SessionContent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

            <!-- 连接中：轻量遮罩，不打断用户 -->
            <Border Background="{DynamicResource Bg.Session}"
                    Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Profile.Name}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#E6E6E6"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0">
                        <Run Text="正在连接" />
                        <Run Text="{Binding Profile.Host, Mode=OneWay}" />
                        <Run Text="…" />
                    </TextBlock>

                    <!-- 连接进度：不确定进度条，克制的动效 -->
                    <ProgressBar IsIndeterminate="True"
                                 Width="180" Height="2"
                                 Margin="0,18,0,0"
                                 Background="#2E2E2E"
                                 Foreground="{DynamicResource Brand.Default}"
                                 BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- 断线 / 失败：会话内部状态层 + 重新连接，不弹模态错误框 -->
            <Border Background="#D9141414"
                    Visibility="{Binding IsInterrupted, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Surface.Card}"
                        MaxWidth="440"
                        Padding="28,24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StateIcon}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}" />
                            <TextBlock Text="{Binding StateText}"
                                       Style="{StaticResource Text.SectionTitle}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding InterruptionMessage}"
                                   Style="{StaticResource Text.BodySecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Secondary}"
                                    Content="关闭会话"
                                    Command="{Binding CloseCommand}" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Content="重新连接"
                                    Margin="8,0,0,0"
                                    Command="{Binding ReconnectCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
