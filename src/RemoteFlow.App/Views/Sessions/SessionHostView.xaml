<UserControl x:Class="RemoteFlow.App.Views.Sessions.SessionHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SessionTabViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />

        <!-- 会话工具条上的紧凑图标按钮 -->
        <Style x:Key="Session.BarButton" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <!-- 内容铺满；工具条是悬浮、可拖动、可自动隐藏的独立浮条 -->
    <Grid x:Name="RootGrid" Background="{DynamicResource Bg.Session}">

        <!-- ══ 会话内容 ═════════════════════════════════════════════ -->
        <!-- 协议视图由代码后置按会话类型注入；必须拉伸填满，否则全屏后
             RDP/VNC 画面会缩在左上角、四周留黑边。 -->
        <ContentControl x:Name="SessionContent"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

        <!-- 连接中：轻量遮罩，不打断用户 -->
        <Border Background="{DynamicResource Bg.Session}"
                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Profile.Name}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#E6E6E6"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Caption}"
                           Foreground="#9E9E9E"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0">
                    <Run Text="正在连接" />
                    <Run Text="{Binding Profile.Host, Mode=OneWay}" />
                    <Run Text="…" />
                </TextBlock>
                <ProgressBar IsIndeterminate="True"
                             Width="180" Height="2"
                             Margin="0,18,0,0"
                             Background="#2E2E2E"
                             Foreground="{DynamicResource Brand.Default}"
                             BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- 断线 / 失败：会话内部状态层 + 重新连接，不弹模态错误框 -->
        <Border Background="#D9141414"
                Visibility="{Binding IsInterrupted, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Surface.Card}"
                    MaxWidth="440"
                    Padding="28,24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StateIcon}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}" />
                        <TextBlock Text="{Binding StateText}"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding InterruptionMessage}"
                               Style="{StaticResource Text.BodySecondary}"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="关闭会话"
                                Command="{Binding CloseCommand}" />
                        <Button Style="{StaticResource Button.Primary}"
                                Content="重新连接"
                                Margin="8,0,0,0"
                                Command="{Binding ReconnectCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ══ 会话工具条（悬浮 Popup）══════════════════════════════════
             RDP 会话内嵌原生 ActiveX（airspace），普通 WPF 浮层会被它盖住、
             也收不到其上的鼠标事件。用 Popup（独立顶层窗口）承载工具条，
             这也是 mstsc 连接条的做法；顶沿唤出由代码后置轮询光标实现。
             整条可用鼠标拖动到任意位置。 -->
        <Popup x:Name="ToolbarPopup"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Relative"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               HorizontalOffset="0"
               VerticalOffset="0">
            <Border x:Name="Toolbar"
                    Margin="10"
                    Padding="4"
                    Background="{DynamicResource Bg.Layer}"
                    BorderBrush="{DynamicResource Stroke.Subtle}"
                    BorderThickness="1"
                    CornerRadius="9"
                    MouseLeftButtonDown="OnToolbarDragStart"
                    MouseMove="OnToolbarDragMove"
                    MouseLeftButtonUp="OnToolbarDragEnd">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#000000" />
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- 拖动手柄 + 会话切换 -->
                    <Button x:Name="SessionSwitchButton"
                            Style="{StaticResource Session.BarButton}"
                            Width="Auto"
                            Padding="8,0"
                            Click="OnSessionSwitchClick"
                            ToolTip="切换会话">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Sessions}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="SessionSwitchLabel"
                                       Text="{Binding Title}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="12"
                                       MaxWidth="140"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="6,0,4,0" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 固定 / 取消固定 -->
                    <ToggleButton x:Name="PinToggle"
                                  Width="30" Height="28"
                                  Cursor="Hand"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Checked="OnPinChanged"
                                  Unchecked="OnPinChanged">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="{StaticResource Icon.Unpin}" />
                                <Setter Property="ToolTip" Value="固定工具条" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="{StaticResource Icon.Pin}" />
                                        <Setter Property="ToolTip" Value="取消固定（自动隐藏）" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brand.Default}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="13"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Border Width="1" Height="16" Margin="4,0"
                            Background="{DynamicResource Stroke.Default}" />

                    <!-- 连接状态：图标 + 主机（图标与文字并存，不单靠颜色） -->
                    <TextBlock Text="{Binding StateIcon}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               Foreground="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}"
                               ToolTip="{Binding StateText}" />
                    <TextBlock Text="{Binding Profile.Host}"
                               Style="{StaticResource Text.Caption}"
                               FontFamily="{StaticResource MonoFont}"
                               VerticalAlignment="Center"
                               Margin="7,0,3,0" />

                    <Border Width="1" Height="16" Margin="4,0"
                            Background="{DynamicResource Stroke.Default}" />

                    <!-- 协议专属操作 -->
                    <StackPanel x:Name="RdpTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Scale}"
                                ToolTip="缩放 / 适应窗口"
                                Command="{Binding ToggleScalingCommand}" />
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Keyboard}"
                                ToolTip="发送 Ctrl+Alt+Del"
                                Command="{Binding SendCtrlAltDeleteCommand}" />
                    </StackPanel>

                    <StackPanel x:Name="SshTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Copy}"
                                ToolTip="复制选中内容 (Ctrl+Shift+C)"
                                Command="{Binding CopySelectionCommand}" />
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Paste}"
                                ToolTip="粘贴 (Ctrl+Shift+V)"
                                Command="{Binding PasteClipboardCommand}" />
                    </StackPanel>

                    <StackPanel x:Name="VncTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Scale}"
                                ToolTip="适应窗口 / 1:1"
                                Command="{Binding ToggleScalingCommand}" />
                    </StackPanel>

                    <Border Width="1" Height="16" Margin="4,0"
                            Background="{DynamicResource Stroke.Default}" />

                    <!-- 窗口控制：全屏时应用标题栏被隐藏，这里是唯一的最小化 / 关闭入口 -->
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource Session.BarButton}"
                            Content="{StaticResource Icon.WindowMinimize}"
                            ToolTip="最小化窗口"
                            Click="OnMinimizeWindow" />

                    <!-- 全屏 / 退出全屏：图标与提示随窗口全屏状态切换 -->
                    <Button x:Name="FullScreenButton" Command="{Binding ToggleFullScreenCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Session.BarButton}">
                                <Setter Property="Content" Value="{StaticResource Icon.FullScreen}" />
                                <Setter Property="ToolTip" Value="全屏 (F11)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSessionFullScreen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Content" Value="{StaticResource Icon.WindowRestore}" />
                                        <Setter Property="ToolTip" Value="退出全屏 (F11 / Esc)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="CloseSessionButton"
                            Style="{StaticResource Session.BarButton}"
                            Content="{StaticResource Icon.Close}"
                            ToolTip="关闭会话 (Ctrl+W)"
                            Command="{Binding CloseCommand}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
