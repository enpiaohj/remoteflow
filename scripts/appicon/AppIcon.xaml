<!-- RemoteFlow 程序图标「立体双箭头」。1024 设计网格，底座 824 居中（四周留白符合 macOS 图标规范）。
     前箭头白色挤出 + 淡青辉光，后箭头青蓝玻璃作流动回声；底座有厚度侧面、顶边高光与弧形反光。
     本文件由设计脚本展开生成（挤出侧面是逐层下移的同一路径）；由 scripts/render-appicon.ps1 渲染为各尺寸。 -->
<Grid Width="1024" Height="1024" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <!-- 落在桌面上的柔和阴影 -->
  <Border Width="800" Height="800" CornerRadius="180" Margin="0,70,0,0" Background="#0E1550" Opacity="0.55">
    <Border.Effect><BlurEffect Radius="60" /></Border.Effect>
  </Border>
  <!-- 底座侧面（厚度） -->
  <Border Width="824" Height="824" CornerRadius="186" Margin="0,34,0,0">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF1B2384" Offset="0" /><GradientStop Color="#FF121864" Offset="1" /></LinearGradientBrush></Border.Background>
  </Border>
  <!-- 底座正面 -->
  <Border Width="824" Height="824" CornerRadius="186" Margin="0,-10,0,0">
    <Border.Background>
      <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
        <GradientStop Color="#FF7AA2FF" Offset="0" />
        <GradientStop Color="#FF4468F2" Offset="0.42" />
        <GradientStop Color="#FF2A33B0" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.Clip><RectangleGeometry Rect="0,0,824,824" RadiusX="186" RadiusY="186" /></Grid.Clip>
      <!-- 弧形反光：上半部一道柔和的亮面 -->
      <Path Data="M-40,-40 H 864 V 300 C 600,420 260,420 -40,330 Z" Opacity="0.9">
        <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0" /><GradientStop Color="#08FFFFFF" Offset="1" /></LinearGradientBrush></Path.Fill>
      </Path>
      <!-- 底部压暗，增加体积感 -->
      <Rectangle VerticalAlignment="Bottom" Height="420">
        <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000A1060" Offset="0" /><GradientStop Color="#660A1060" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
