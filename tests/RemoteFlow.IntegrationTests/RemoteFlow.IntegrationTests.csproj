<Project Sdk="Microsoft.NET.Sdk">

  <!--
    跨平台集成测试：SQLite 仓储、应用服务、凭据备份、会话生命周期。
    保持 net10.0 且不引用任何 UI / 平台专属工程，使这批测试能在
    Windows 与 macOS 双端运行——这是 macOS 移植期间共享层重构的回归网。
    平台专属验证见 RemoteFlow.IntegrationTests.Windows。
    对应 macOS 版技术方案 §6.1 / §10。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteFlow.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RemoteFlow.Core\RemoteFlow.Core.csproj" />
    <ProjectReference Include="..\..\src\RemoteFlow.Application\RemoteFlow.Application.csproj" />
    <ProjectReference Include="..\..\src\RemoteFlow.Infrastructure\RemoteFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\RemoteFlow.Presentation\RemoteFlow.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
