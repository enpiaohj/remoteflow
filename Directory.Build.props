<Project>

  <!-- RemoteFlow 全解决方案统一属性 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      允许在 macOS / Linux 上编译 net10.0-windows 目标（WPF / WinForms / Protocol.Rdp）。
      仅影响编译期：拉取 Windows Targeting Pack，使 macOS 开发机能对 Windows 侧做
      构建校验，避免共享层重构时把 Windows 版改坏却要等到换机器才发现。
      产物仍只能在 Windows 上运行。在 Windows 上此属性无副作用。
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- 产品与版本信息：正式发布时统一在此处递增 -->
  <PropertyGroup>
    <Product>RemoteFlow</Product>
    <Company>RemoteFlow</Company>
    <Authors>RemoteFlow</Authors>
    <VersionPrefix>0.18.1</VersionPrefix>
    <AssemblyVersion>0.18.1.0</AssemblyVersion>
    <FileVersion>0.18.1.0</FileVersion>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <!--
    Release 配置下全解决方案不生成调试符号，也不带第三方 XML 文档，
    使 dotnet publish 的发布产物只有可执行文件与运行时资源。
    Debug 配置不受影响，仍保留完整符号供开发调试。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

</Project>
