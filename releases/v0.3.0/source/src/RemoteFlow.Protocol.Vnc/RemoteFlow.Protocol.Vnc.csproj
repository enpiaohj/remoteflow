<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RemoteFlow.Protocol.Vnc —— VNC / macOS Screen Sharing 协议适配层。
    使用 Community.MarcusW.VncClient（MIT，纯托管 RFB 实现），
    自行实现 WPF WriteableBitmap 渲染目标。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>RemoteFlow.Protocol.Vnc</RootNamespace>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteFlow.Core\RemoteFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Community.MarcusW.VncClient" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
