<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        浅色主题调色板（默认主题）。
        所有控件样式只引用这里的语义键（Bg.* / Text.* / Stroke.* / Brand.*），
        因此切换主题时无需改动任何控件模板。

        v4（2026-09，改用真正的 Windows 11 默认配色思路）：
        v2/v3 都在「机身一个色、内容一大块纯白」上打转——不管两者色相是否
        统一，只要中央是一整块跟机身对比鲜明的纯白，就会显得「中间太白，
        外面太灰」。Windows 11 原生应用（文件资源管理器、设置）从来不这样：
        整个窗口（标题栏、导航栏、内容区）都是同一种极浅灰 Mica 底色，
        只有各个「卡片」本身是白的，卡片以外的空白仍然是那种浅灰。
        v4 直接照这个来：Bg.Base 用 Win11 系统底色 #F3F3F3，中央工作区
        底色也改成 Bg.Base（不再是一整块纯白），只有 Surface.Card 包裹的
        具体内容块（连接列表、凭据表格、设置卡片、首页卡片）才是白色。
        中性色也回到接近真灰阶（不刻意染色相），只有品牌色是唯一彩色。
    -->

    <!-- 机身与中央工作区**同一底色**——Windows 11 的 Mica 精神：整窗一个底，
         内容靠卡片而不是大块色差分层 -->
    <SolidColorBrush x:Key="Bg.Base" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Bg.Sidebar" Color="#F3F3F3" />
    <!-- 纸张：只用于卡片本身（Surface.Card）等具体内容块，不再是整个内容区的底色 -->
    <SolidColorBrush x:Key="Bg.Layer" Color="#FFFFFF" />
    <!-- 卡片内的凹陷区（表头、内嵌块、图标块底） -->
    <SolidColorBrush x:Key="Bg.Subtle" Color="#F7F7F7" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#EBEBEB" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="#DFDFDF" />
    <SolidColorBrush x:Key="Bg.Selected" Color="#E7EDFB" />
    <SolidColorBrush x:Key="Bg.SelectedHover" Color="#DAE3F8" />
    <SolidColorBrush x:Key="Bg.RowSelected" Color="#F1F5FE" />
    <SolidColorBrush x:Key="Bg.RowSelectedHover" Color="#E4EDFC" />
    <SolidColorBrush x:Key="Bg.Session" Color="#12131A" />

    <!-- 文字层级：3 级灰度 + 反色，贴近 Windows 系统灰阶，不刻意染色相 -->
    <SolidColorBrush x:Key="Text.Primary" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#5B5B5B" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#868686" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#ACACAC" />

    <!-- 描边：贴近 Windows 系统灰阶，只在卡片 / 输入框边界处使用 -->
    <SolidColorBrush x:Key="Stroke.Subtle" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Stroke.Default" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Stroke.Strong" Color="#BDBDBD" />
    <SolidColorBrush x:Key="Stroke.Focus" Color="#3352CE" />

    <!-- 品牌色：全应用唯一的彩色元素，其余全是灰阶 -->
    <Color x:Key="Brand.Color">#3352CE</Color>
    <SolidColorBrush x:Key="Brand.Default" Color="#3352CE" />
    <SolidColorBrush x:Key="Brand.Hover" Color="#2C46B4" />
    <SolidColorBrush x:Key="Brand.Pressed" Color="#233890" />
    <SolidColorBrush x:Key="Brand.Subtle" Color="#EAEEFB" />

    <!-- 状态色。注意：状态绝不单独依赖颜色传达，必须同时有文字或图标 -->
    <SolidColorBrush x:Key="Status.Success" Color="#12794F" />
    <SolidColorBrush x:Key="Status.Warning" Color="#985900" />
    <SolidColorBrush x:Key="Status.Danger" Color="#C4342A" />
    <SolidColorBrush x:Key="Status.DangerHover" Color="#A62B22" />
    <SolidColorBrush x:Key="Status.Info" Color="#3352CE" />
    <SolidColorBrush x:Key="Status.Idle" Color="#868686" />

    <!-- 协议标识色：三色相互拉开，同时都能落在白色卡片上保持可读 -->
    <SolidColorBrush x:Key="Protocol.Rdp" Color="#3352CE" />
    <SolidColorBrush x:Key="Protocol.Ssh" Color="#0E7C57" />
    <SolidColorBrush x:Key="Protocol.Vnc" Color="#7A4FC4" />

    <!-- 卡片投影颜色（DropShadowEffect.Color 需要 Color 而非 Brush） -->
    <Color x:Key="Shadow.Cast">#1A1A1A</Color>
    <SolidColorBrush x:Key="Shadow.Color" Color="#141A1A1A" />

</ResourceDictionary>
