<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        图标系统。
        统一使用 Windows 11 自带的 Segoe Fluent Icons 字体，回退到 Segoe MDL2 Assets，
        避免混用多套图标语言，也省去维护上百条 Path 几何数据。
    -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 导航 -->
    <sys:String x:Key="Icon.Home">&#xE80F;</sys:String>
    <sys:String x:Key="Icon.Connections">&#xE968;</sys:String>
    <sys:String x:Key="Icon.Recent">&#xE81C;</sys:String>
    <sys:String x:Key="Icon.Favorite">&#xE734;</sys:String>
    <sys:String x:Key="Icon.FavoriteFilled">&#xE735;</sys:String>
    <sys:String x:Key="Icon.Tag">&#xE8EC;</sys:String>
    <sys:String x:Key="Icon.Credential">&#xE8D7;</sys:String>
    <sys:String x:Key="Icon.ImportExport">&#xEDE1;</sys:String>
    <sys:String x:Key="Icon.Settings">&#xE713;</sys:String>

    <!-- 协议 -->
    <sys:String x:Key="Icon.Rdp">&#xE7F4;</sys:String>
    <sys:String x:Key="Icon.Ssh">&#xE756;</sys:String>
    <sys:String x:Key="Icon.Vnc">&#xE7F8;</sys:String>

    <!-- 操作 -->
    <sys:String x:Key="Icon.Search">&#xE721;</sys:String>
    <sys:String x:Key="Icon.Add">&#xE710;</sys:String>
    <sys:String x:Key="Icon.Edit">&#xE70F;</sys:String>
    <sys:String x:Key="Icon.Copy">&#xE8C8;</sys:String>
    <sys:String x:Key="Icon.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Icon.Close">&#xE711;</sys:String>
    <sys:String x:Key="Icon.More">&#xE712;</sys:String>
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Icon.Connect">&#xE8AF;</sys:String>
    <sys:String x:Key="Icon.Save">&#xE74E;</sys:String>
    <sys:String x:Key="Icon.Accept">&#xE73E;</sys:String>
    <sys:String x:Key="Icon.Clear">&#xE894;</sys:String>
    <sys:String x:Key="Icon.Reveal">&#xE7B3;</sys:String>
    <sys:String x:Key="Icon.Hide">&#xED1A;</sys:String>
    <sys:String x:Key="Icon.Download">&#xE896;</sys:String>
    <sys:String x:Key="Icon.Upload">&#xE898;</sys:String>
    <sys:String x:Key="Icon.Database">&#xE8B7;</sys:String>
    <sys:String x:Key="Icon.Lock">&#xE72E;</sys:String>
    <sys:String x:Key="Icon.Appearance">&#xE771;</sys:String>
    <sys:String x:Key="Icon.Power">&#xE7E8;</sys:String>
    <sys:String x:Key="Icon.Language">&#xE774;</sys:String>

    <!-- 会话工具条 -->
    <sys:String x:Key="Icon.FullScreen">&#xE740;</sys:String>
    <sys:String x:Key="Icon.ExitFullScreen">&#xE73F;</sys:String>
    <sys:String x:Key="Icon.Scale">&#xE9A6;</sys:String>
    <sys:String x:Key="Icon.Clipboard">&#xE8C8;</sys:String>
    <sys:String x:Key="Icon.Keyboard">&#xE765;</sys:String>
    <!-- 启动任务管理器：Segoe Fluent 的 Diagnostic(U+E9D9，仪表/诊断形)，
         贴近远端任务管理器的性能/进程仪表语义；目测不理想可换 E9F3(Process)/文字兜底。 -->
    <sys:String x:Key="Icon.TaskManager">&#xE9D9;</sys:String>
    <sys:String x:Key="Icon.Paste">&#xE77F;</sys:String>
    <sys:String x:Key="Icon.Pin">&#xE718;</sys:String>
    <sys:String x:Key="Icon.Unpin">&#xE77A;</sys:String>
    <sys:String x:Key="Icon.Sessions">&#xE71D;</sys:String>
    <sys:String x:Key="Icon.WindowMinimize">&#xE921;</sys:String>
    <sys:String x:Key="Icon.WindowMaximize">&#xE922;</sys:String>
    <sys:String x:Key="Icon.WindowRestore">&#xE923;</sys:String>

    <!-- 结构与状态 -->
    <sys:String x:Key="Icon.Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Icon.ChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="Icon.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Icon.Shield">&#xEA18;</sys:String>
    <sys:String x:Key="Icon.Info">&#xE946;</sys:String>
    <sys:String x:Key="Icon.Error">&#xEA39;</sys:String>
    <sys:String x:Key="Icon.Success">&#xE930;</sys:String>
    <sys:String x:Key="Icon.Pending">&#xE895;</sys:String>

</ResourceDictionary>
