    编排 Core 中的领域对象与 Infrastructure 提供的能力，不直接依赖 UI 框架。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteFlow.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteFlow.Core\RemoteFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- CSV 解析属于内部实现细节，但其边界情况（引号、字段内逗号与换行）值得单独测试 -->
    <InternalsVisibleTo Include="RemoteFlow.Core.Tests" />
  </ItemGroup>

</Project>
