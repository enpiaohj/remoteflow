<UserControl x:Class="RemoteFlow.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutPageViewModel}">

    <UserControl.Resources>
        <!-- 与帮助页同一套视觉语言：品牌色图标瓦片 + Surface.Card -->
        <Style x:Key="About.Tile" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Brand.Subtle}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- 信息行标签 / 描述列统一 96，与隐私条目对齐 -->
        <Style x:Key="About.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.BodySecondary}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 隐私条目正文：换行 + 行距 -->
        <Style x:Key="About.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>

        <!-- 可点击的外链：品牌色 + 下划线，与正文区分 -->
        <Style x:Key="About.Link" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Brand.Default}" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
    </UserControl.Resources>

    <!-- 与设置页同款根 margin -->
    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="关于" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="版本、许可与数据合规说明。"
                       Style="{StaticResource Text.BodySecondary}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,20">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                <!-- ══ 产品 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Brand.Default}">
                            <TextBlock Text="&#xE8AF;" FontFamily="{StaticResource IconFont}" FontSize="21"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RemoteFlow" Style="{StaticResource Text.SectionTitle}" FontSize="20" />
                            <TextBlock Text="统一远程连接工作台" Style="{StaticResource Text.BodySecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ 版本与归属 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource About.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.Info}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="版本与归属" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Style="{StaticResource About.Label}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="开发者" Style="{StaticResource About.Label}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Hyperlink Click="OnLinkClick" NavigateUri="https://github.com/enpiaohj" Style="{StaticResource About.Link}">
                                        <Run Text="enpiaohj" /><Run Text="（GitHub）" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="源码仓库" Style="{StaticResource About.Label}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Hyperlink Click="OnLinkClick" NavigateUri="https://github.com/enpiaohj/remoteflow" Style="{StaticResource About.Link}">
                                        <Run Text="github.com/enpiaohj/remoteflow" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="许可证" Style="{StaticResource About.Label}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="GPL-3.0" Style="{StaticResource Text.Body}" Margin="0,10,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <Border Background="{DynamicResource Bg.Subtle}"
                                    CornerRadius="{StaticResource Radius.Medium}"
                                    Padding="12,10" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           Text="本应用依据 GPL-3.0 许可证发布，不附带任何担保。随源码分发与运行时引用的第三方组件及其许可证，详见仓库中的 THIRD-PARTY-NOTICES.md。" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 隐私与数据 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource About.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.Shield}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="隐私与数据" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="本地存储" Style="{StaticResource About.Label}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource About.Body}">
                                    连接配置、会话历史等应用数据存储于本机 SQLite 数据库，除用户主动导出或启用云同步外不会离开本机。
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="凭据保护" Style="{StaticResource About.Label}" Margin="0,10,0,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource About.Body}" Margin="0,10,0,0">
                                    密码与私钥经 Windows DPAPI 以当前用户作用域加密存储；日志、导出文件与异常信息中不包含明文凭据。
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="对外通信" Style="{StaticResource About.Label}" Margin="0,10,0,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource About.Body}" Margin="0,10,0,0">
                                    除你发起的远程连接（RDP / SSH / VNC）及显式启用并配对的 AppsCloud 云同步外，应用不向任何第三方服务发送数据，亦不包含遥测、崩溃报告或使用统计组件。
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="主机密钥" Style="{StaticResource About.Label}" Margin="0,10,0,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource About.Body}" Margin="0,10,0,0">
                                    SSH 主机密钥采用「首次信任」（TOFU）策略：首次连接记录指纹，后续连接逐次校验；指纹变更时阻断连接并要求人工确认。
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
