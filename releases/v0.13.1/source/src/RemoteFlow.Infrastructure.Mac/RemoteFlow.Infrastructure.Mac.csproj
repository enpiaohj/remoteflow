<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RemoteFlow.Infrastructure.Mac —— Infrastructure 中依赖 macOS 专属 API 的部分。
    目前只有 KeychainCredentialVault（Security.framework / Keychain Services），
    是 Windows 侧 DpapiCredentialVault 的对等实现。
    对应 macOS 版技术方案 §6.4。

    目标框架保持 net10.0（而非 net10.0-macos）：本工程只用 P/Invoke 调用系统框架，
    不需要 Xamarin/MAUI 的 macOS 绑定，这样 Windows 开发机也能对其做编译校验。
    平台约束由 [SupportedOSPlatform("macos")] 在类型层面表达。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteFlow.Infrastructure.Mac</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteFlow.Core\RemoteFlow.Core.csproj" />
    <ProjectReference Include="..\RemoteFlow.Infrastructure\RemoteFlow.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
