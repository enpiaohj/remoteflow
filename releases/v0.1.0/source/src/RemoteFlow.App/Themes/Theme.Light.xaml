<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        浅色主题调色板（默认主题）。
        取值参考 Windows 11 / Fluent 语义色，保证与系统观感一致。
        所有控件样式只引用这里的语义键（Bg.* / Text.* / Stroke.* / Brand.*），
        因此切换主题时无需改动任何控件模板。
    -->

    <!-- 背景层级：Base 是窗口底色，Layer 是内容面板，越靠上层越亮 -->
    <SolidColorBrush x:Key="Bg.Base" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Bg.Layer" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Sidebar" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Bg.Subtle" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#EDEDED" />
    <SolidColorBrush x:Key="Bg.Pressed" Color="#E4E4E4" />
    <SolidColorBrush x:Key="Bg.Selected" Color="#E8F1FB" />
    <SolidColorBrush x:Key="Bg.SelectedHover" Color="#DCEAF8" />
    <SolidColorBrush x:Key="Bg.Session" Color="#1E1E1E" />

    <!-- 文字层级：最多 3 级灰度 + 反色，避免层级过多造成视觉噪音 -->
    <SolidColorBrush x:Key="Text.Primary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#5D5D5D" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#A6A6A6" />

    <!-- 描边：优先用间距分隔区域，描边只在必要处使用 -->
    <SolidColorBrush x:Key="Stroke.Subtle" Color="#EBEBEB" />
    <SolidColorBrush x:Key="Stroke.Default" Color="#DCDCDC" />
    <SolidColorBrush x:Key="Stroke.Strong" Color="#C4C4C4" />
    <SolidColorBrush x:Key="Stroke.Focus" Color="#0F6CBD" />

    <!-- 品牌色：全应用唯一主操作色 -->
    <Color x:Key="Brand.Color">#0F6CBD</Color>
    <SolidColorBrush x:Key="Brand.Default" Color="#0F6CBD" />
    <SolidColorBrush x:Key="Brand.Hover" Color="#115EA3" />
    <SolidColorBrush x:Key="Brand.Pressed" Color="#0E4A78" />
    <SolidColorBrush x:Key="Brand.Subtle" Color="#EFF6FC" />

    <!-- 状态色。注意：状态绝不单独依赖颜色传达，必须同时有文字或图标 -->
    <SolidColorBrush x:Key="Status.Success" Color="#0F7B0F" />
    <SolidColorBrush x:Key="Status.Warning" Color="#9D5D00" />
    <SolidColorBrush x:Key="Status.Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="Status.DangerHover" Color="#A82217" />
    <SolidColorBrush x:Key="Status.Info" Color="#0F6CBD" />
    <SolidColorBrush x:Key="Status.Idle" Color="#8A8A8A" />

    <!-- 协议标识色：用于连接列表中快速区分协议 -->
    <SolidColorBrush x:Key="Protocol.Rdp" Color="#0F6CBD" />
    <SolidColorBrush x:Key="Protocol.Ssh" Color="#0F7B0F" />
    <SolidColorBrush x:Key="Protocol.Vnc" Color="#8764B8" />

    <SolidColorBrush x:Key="Shadow.Color" Color="#20000000" />

</ResourceDictionary>
