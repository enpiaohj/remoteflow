<UserControl x:Class="RemoteFlow.App.Views.Pages.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionsPageViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <conv:ColorStringToBrushConverter x:Key="ColorToBrush" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 页面标题与工具条 ──────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 收藏与最近是同一页面的两个筛选视图，标题随之变化 -->
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}">
                            <Setter Property="Text" Value="我的连接" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filter}" Value="Favorites">
                                    <Setter Property="Text" Value="收藏" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Filter}" Value="Recent">
                                    <Setter Property="Text" Value="最近连接" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Background="{DynamicResource Bg.Subtle}"
                        CornerRadius="10" Padding="8,2" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Items.Count}" Style="{StaticResource Text.Caption}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ToggleButton IsChecked="{Binding GroupByFolder}"
                              ToolTip="按分组折叠显示"
                              Width="36" Height="36"
                              Cursor="Hand"
                              Background="Transparent"
                              BorderThickness="0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="4">
                                <TextBlock Text="{StaticResource Icon.Folder}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Button Style="{StaticResource Button.Icon}"
                        Content="{StaticResource Icon.Refresh}"
                        ToolTip="刷新"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- ── 搜索结果提示 ──────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brand.Subtle}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding SearchText.Length, Converter={StaticResource CountToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{StaticResource Icon.Search}"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="12"
                           Foreground="{DynamicResource Brand.Default}"
                           VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="8,0,0,0">
                    <Run Text="正在搜索" />
                    <Run Text="{Binding SearchText, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="，找到" />
                    <Run Text="{Binding Items.Count, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="条结果" />
                </TextBlock>
                <Button Style="{StaticResource Button.Subtle}"
                        Content="清除"
                        MinHeight="24"
                        Padding="8,0"
                        FontSize="12"
                        Margin="12,0,0,0"
                        Command="{Binding ClearSearchCommand}" />
            </StackPanel>
        </Border>

        <!-- ── 列头 ──────────────────────────────────────────── -->
        <Grid Grid.Row="2" Height="32" Margin="4,0,4,0"
              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource Text.Caption}" Margin="34,0,0,0" />
            <TextBlock Grid.Column="2" Text="IP / 主机" Style="{StaticResource Text.Caption}" />
            <TextBlock Grid.Column="3" Text="协议" Style="{StaticResource Text.Caption}" />
            <TextBlock Grid.Column="4" Text="标签" Style="{StaticResource Text.Caption}" />
            <TextBlock Grid.Column="5" Text="最近连接" Style="{StaticResource Text.Caption}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Surface.Divider}" VerticalAlignment="Bottom" Margin="4,0" />

        <!-- ── 连接列表 ──────────────────────────────────────── -->
        <Grid Grid.Row="3">

            <ListBox x:Name="ConnectionList"
                     Style="{StaticResource List.Plain}"
                     ItemsSource="{Binding ItemsView}"
                     SelectedItem="{Binding SelectedItem}"
                     Margin="0,4,0,0"
                     Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}"
                     MouseDoubleClick="OnListDoubleClick"
                     KeyDown="OnListKeyDown">

                <!-- 分组折叠 -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                                        <TextBlock Text="{StaticResource Icon.Folder}"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource Text.Primary}"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource Bg.Subtle}"
                                                                CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ItemCount}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Text.Tertiary}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <!-- 紧凑行 -->
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectionItemViewModel}">
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>

                            <!-- 收藏星标 -->
                            <Button Grid.Column="0"
                                    Width="28" Height="28"
                                    FontSize="14"
                                    ToolTip="收藏 / 取消收藏"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                        <Setter Property="Content" Value="{StaticResource Icon.Favorite}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Content" Value="{StaticResource Icon.FavoriteFilled}" />
                                                <Setter Property="Foreground" Value="#F2C037" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 名称 + 协议图标 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="5"
                                        Background="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}"
                                        Opacity="0.14" />
                                <TextBlock Text="{Binding ProtocolIcon}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Margin="-24,0,0,0"
                                           Width="24"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}" />
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource Text.Body}"
                                           Margin="10,0,8,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding HostDisplay}"
                                       Style="{StaticResource Text.BodySecondary}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding ProtocolName}"
                                       Style="{StaticResource Text.BodySecondary}"
                                       FontSize="12" />

                            <!-- 标签：最多 3 个，超出以 +N 表示 -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="7,2" Margin="0,0,4,0"
                                                    Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                                    Opacity="0.92">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           Foreground="White"
                                                           MaxWidth="70"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding OverflowTagCount, StringFormat=+{0}}"
                                           Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding OverflowTagCount, Converter={StaticResource CountToVisibility}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="5"
                                       Text="{Binding LastConnectedDisplay}"
                                       Style="{StaticResource Text.Caption}" />

                            <!-- 低频操作收进「更多」菜单 -->
                            <Button Grid.Column="6"
                                    Style="{StaticResource Button.Icon}"
                                    Width="30" Height="30"
                                    Content="{StaticResource Icon.More}"
                                    ToolTip="更多操作"
                                    Click="OnMoreClick">
                                <Button.ContextMenu>
                                    <!-- ContextMenu 不在主可视树内，绑定祖先 DataContext 不可靠，
                                         因此统一用 Click 事件在代码后置中分发。 -->
                                    <ContextMenu>
                                        <MenuItem Header="连接" InputGestureText="Enter" Click="OnConnectMenuClick" />
                                        <Separator />
                                        <MenuItem Header="编辑" Click="OnEditMenuClick" />
                                        <MenuItem Header="复制" Click="OnDuplicateMenuClick" />
                                        <Separator />
                                        <MenuItem Header="删除" Click="OnDeleteMenuClick" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ── 空状态 ────────────────────────────────────── -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="380"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Border Width="56" Height="56" CornerRadius="16"
                        Background="{DynamicResource Bg.Subtle}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="{StaticResource Icon.Connections}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="24"
                               Foreground="{DynamicResource Text.Tertiary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding EmptyMessage}"
                           Style="{StaticResource Text.BodySecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,16,0,0" />
                <Button Style="{StaticResource Button.Primary}"
                        Content="新建连接"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Command="{Binding CreateCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
