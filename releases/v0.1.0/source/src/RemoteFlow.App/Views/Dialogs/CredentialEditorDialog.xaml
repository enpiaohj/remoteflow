<Window x:Class="RemoteFlow.App.Views.Dialogs.CredentialEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
        xmlns:vm="clr-namespace:RemoteFlow.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CredentialEditorViewModel}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="560"
        SizeToContent="Height"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumDisplayNameConverter x:Key="EnumDisplay" />

        <Style x:Key="FormRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.26" Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="56" x:Name="TitleBar">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}"
                           VerticalAlignment="Center" Margin="24,0,0,0" />
                <Button Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Close}"
                        HorizontalAlignment="Right" Margin="0,0,12,0"
                        IsCancel="True" Click="OnCancelClick" />
            </Grid>
            <Border Grid.Row="0" Style="{StaticResource Surface.Divider}" VerticalAlignment="Bottom" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,18">
                <StackPanel>

                    <Grid Style="{StaticResource FormRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource Text.FieldLabel}" />
                        <TextBox Grid.Column="1" x:Name="NameBox" Style="{StaticResource Input.TextBox}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Style="{StaticResource FormRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="类型" Style="{StaticResource Text.FieldLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource Input.ComboBox}"
                                  ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding Type}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource FormRow}"
                          Visibility="{Binding NeedsDomain, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="域" Style="{StaticResource Text.FieldLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}"
                                 Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Style="{StaticResource FormRow}"
                          Visibility="{Binding NeedsUsername, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="用户名" Style="{StaticResource Text.FieldLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}"
                                 FontFamily="{StaticResource MonoFont}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- 密码：PasswordBox 不参与数据绑定，值由代码后置在确认时一次性读取，
                         避免明文密码以绑定属性的形式长期驻留在 ViewModel 中。 -->
                    <Grid Style="{StaticResource FormRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PasswordLabel}" Style="{StaticResource Text.FieldLabel}"
                                   VerticalAlignment="Top" Margin="0,7,12,0" />
                        <StackPanel Grid.Column="1">
                            <PasswordBox x:Name="PasswordInput" Style="{StaticResource Input.PasswordBox}" />
                            <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource FormRow}"
                          Visibility="{Binding NeedsPrivateKey, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="私钥" Style="{StaticResource Text.FieldLabel}"
                                   VerticalAlignment="Top" Margin="0,7,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBox Style="{StaticResource Input.TextArea}"
                                     MinHeight="120"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="11"
                                     Text="{Binding EnteredPrivateKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding PrivateKeyHint}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource FormRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="备注" Style="{StaticResource Text.FieldLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Shield}" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" Foreground="{DynamicResource Status.Success}"
                                       VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Margin="9,0,0,0" MaxWidth="420" HorizontalAlignment="Left"
                                       Text="密码与私钥经 Windows DPAPI 加密后保存在本机保险库文件中，只有当前 Windows 账户能解密。连接数据库中只保存引用键。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource Bg.Subtle}" CornerRadius="0,0,9,9" Padding="20,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{StaticResource Icon.Error}" FontFamily="{StaticResource IconFont}"
                                   FontSize="13" Foreground="{DynamicResource Status.Danger}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Status.Danger}" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Secondary}" Content="取消" IsCancel="True" Click="OnCancelClick" />
                        <Button Style="{StaticResource Button.Primary}" Content="保存" Margin="8,0,0,0"
                                IsDefault="True" Click="OnSaveClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
