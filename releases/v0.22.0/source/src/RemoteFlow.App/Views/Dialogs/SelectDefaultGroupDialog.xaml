<Window x:Class="RemoteFlow.App.Views.Dialogs.SelectDefaultGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:RemoteFlow.Presentation.Services;assembly=RemoteFlow.Presentation"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextElement.Foreground="{DynamicResource Text.Primary}">

    <Border Background="{DynamicResource Bg.Layer}" BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1" CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Margin="28,24,28,0">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           Margin="0,8,0,0" />
                <ListBox x:Name="GroupList" Margin="0,14,0,0" MaxHeight="260"
                         Style="{StaticResource List.Plain}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:DefaultGroupOption}">
                            <StackPanel Orientation="Horizontal" Height="34">
                                <TextBlock Text="{StaticResource Icon.Folder}" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Foreground="{DynamicResource Text.Secondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="0,0,11,11"
                    Margin="0,22,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}" Content="取消" IsCancel="True"
                            Click="OnCancelClick" />
                    <Button Style="{StaticResource Button.Primary}" Content="确定" IsDefault="True"
                            Margin="8,0,0,0" Click="OnConfirmClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
