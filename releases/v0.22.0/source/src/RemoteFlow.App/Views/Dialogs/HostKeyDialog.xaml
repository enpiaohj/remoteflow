<Window x:Class="RemoteFlow.App.Views.Dialogs.HostKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextElement.Foreground="{DynamicResource Text.Primary}">

    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.26" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Margin="28,26,28,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IconGlyph"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="20"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource Text.SectionTitle}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource Text.BodySecondary}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0" />

                <!-- 指纹详情 -->
                <Border Background="{DynamicResource Bg.Subtle}"
                        CornerRadius="8"
                        Padding="16,14"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="主机" Style="{StaticResource Text.Caption}" />
                            <TextBlock Grid.Column="1" x:Name="HostText"
                                       Style="{StaticResource Text.Body}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="算法" Style="{StaticResource Text.Caption}" />
                            <TextBlock Grid.Column="1" x:Name="AlgorithmText"
                                       Style="{StaticResource Text.Body}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="本次指纹" Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" x:Name="FingerprintText"
                                       Style="{StaticResource Text.Body}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <!-- 仅在指纹变化时显示原有指纹，方便用户直接比对 -->
                        <Grid x:Name="KnownFingerprintRow" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="原有指纹" Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" x:Name="KnownFingerprintText"
                                       Style="{StaticResource Text.Body}"
                                       Foreground="{DynamicResource Status.Danger}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="AdviceText"
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </StackPanel>

            <Border Background="{DynamicResource Bg.Subtle}"
                    CornerRadius="0,0,11,11"
                    Margin="0,24,0,0"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RejectButton"
                            Style="{StaticResource Button.Secondary}"
                            Content="取消连接"
                            MinWidth="96"
                            IsCancel="True"
                            Click="OnRejectClick" />
                    <Button x:Name="AcceptButton"
                            Style="{StaticResource Button.Primary}"
                            Content="信任并继续"
                            MinWidth="104"
                            Margin="8,0,0,0"
                            Click="OnAcceptClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
