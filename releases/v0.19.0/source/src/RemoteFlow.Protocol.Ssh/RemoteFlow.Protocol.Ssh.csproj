<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RemoteFlow.Protocol.Ssh —— SSH 协议适配层。
    仅负责协议连接与数据流，终端渲染由 UI 层（xterm.js / WebView2）承担，
    保证「协议层与终端渲染层分离」。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteFlow.Protocol.Ssh</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteFlow.Core\RemoteFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
