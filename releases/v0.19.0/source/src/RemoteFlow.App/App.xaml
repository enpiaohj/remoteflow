<Application x:Class="RemoteFlow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    索引 0 固定为主题调色板，ThemeService 在运行时整体替换该项来切换深浅色。
                    后续字典只引用语义键，因此无需随主题变化。
                -->
                <ResourceDictionary Source="Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.Base.xaml" />
                <ResourceDictionary Source="Themes/Controls.Collections.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
