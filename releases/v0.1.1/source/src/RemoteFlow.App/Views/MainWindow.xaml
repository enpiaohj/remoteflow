<Window x:Class="RemoteFlow.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
        xmlns:vm="clr-namespace:RemoteFlow.App.ViewModels"
        xmlns:pages="clr-namespace:RemoteFlow.App.Views.Pages"
        xmlns:sessions="clr-namespace:RemoteFlow.App.Views.Sessions"
        Title="RemoteFlow"
        Height="820" Width="1440"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Base}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">

    <!-- 自定义标题栏：把全局搜索与「新建连接」直接放进标题栏，
         省掉一整条工具栏，也避免传统「文件/编辑/查看」式菜单栏。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <conv:ColorStringToBrushConverter x:Key="ColorToBrush" />
        <conv:MaximizedPaddingConverter x:Key="MaximizedPadding" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:FullScreenRowHeightConverter x:Key="FullScreenRowHeight" />
        <conv:FullScreenSizeConverter x:Key="FullScreenSize" />

        <!-- 页面 ViewModel → 页面视图 -->
        <DataTemplate DataType="{x:Type vm:HomePageViewModel}">
            <pages:HomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionsPageViewModel}">
            <pages:ConnectionsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CredentialsPageViewModel}">
            <pages:CredentialsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportPageViewModel}">
            <pages:ImportExportPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <pages:SettingsPage />
        </DataTemplate>

        <!-- 标题栏窗口按钮：不使用系统按钮，以便跟随应用主题 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 会话 Tab 头 -->
        <Style x:Key="WorkspaceTabHeader" TargetType="RadioButton">
            <Setter Property="GroupName" Value="WorkspaceTabs" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="6,6,0,0"
                                Margin="0,0,2,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Layer}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- 键盘效率设计（产品设计文档 §7.12） -->
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewConnectionCommand}" />
    </Window.InputBindings>

    <!--
        最大化时补偿 WindowChrome 的边缘溢出，避免内容被屏幕边缘裁切；
        但全屏会话（WindowStyle=None）没有 Chrome，不能再补 8px，否则四周留边。
    -->
    <Border x:Name="RootPadding">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 全屏会话时隐藏应用标题栏，只留会话工具条；靠工具条的全屏按钮或 Esc 退出 -->
                <RowDefinition Height="{Binding IsSessionFullScreen, Converter={StaticResource FullScreenRowHeight}}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══ 标题栏 ══════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="{DynamicResource Bg.Base}"
                  Visibility="{Binding IsSessionFullScreen, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌区 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brand.Default}">
                        <TextBlock Text="&#xE8AF;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="RemoteFlow"
                               FontFamily="{StaticResource UiFontDisplay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <!-- 全局搜索：标题栏两个高频动作之一 -->
                <Border Grid.Column="1"
                        MaxWidth="560"
                        Height="32"
                        Margin="24,0"
                        Background="{DynamicResource Bg.Layer}"
                        BorderBrush="{DynamicResource Stroke.Default}"
                        BorderThickness="1"
                        CornerRadius="6"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{StaticResource Icon.Search}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="{DynamicResource Text.Primary}"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 VerticalContentAlignment="Center"
                                 Margin="8,0" />

                        <!-- 占位提示 -->
                        <TextBlock Grid.Column="1"
                                   Text="搜索服务器、IP、标签、备注…  Ctrl+K"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="9,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="2"
                                Width="28" Height="28"
                                Margin="0,0,2,0"
                                Style="{StaticResource Button.Icon}"
                                Content="{StaticResource Icon.Close}"
                                FontSize="10"
                                ToolTip="清除搜索"
                                Command="{Binding ConnectionsPage.ClearSearchCommand}"
                                Visibility="{Binding GlobalSearchText.Length, Converter={StaticResource CountToVisibility}}" />
                    </Grid>
                </Border>

                <!-- 新建连接：标题栏两个高频动作之二 -->
                <Button Grid.Column="2"
                        Style="{StaticResource Button.Primary}"
                        MinHeight="32"
                        Margin="0,0,12,0"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Command="{Binding NewConnectionCommand}"
                        ToolTip="新建连接 (Ctrl+N)"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Add}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="新建连接" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 窗口控制 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            Click="OnMinimizeClick" ToolTip="最小化" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="OnMaximizeClick" ToolTip="最大化" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                            Click="OnCloseClick" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ══ 主体 ════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- 全屏会话时把导航列宽收为 0，否则会在左侧留下一条空白带 -->
                    <ColumnDefinition x:Name="NavColumn"
                                      Width="{Binding IsSessionFullScreen, Converter={StaticResource FullScreenSize}, ConverterParameter=216}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ── 左侧导航：只放 7 个一级入口 ───────────────── -->
                <Grid Grid.Column="0"
                      Background="{DynamicResource Bg.Sidebar}"
                      Visibility="{Binding IsSessionFullScreen, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,8,0,0">
                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Home, Mode=TwoWay}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationPage.Home}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Home}" Style="{StaticResource IconText}" Width="20" />
                                <TextBlock Text="首页" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Connections, Mode=TwoWay}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationPage.Connections}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Connections}" Style="{StaticResource IconText}" Width="20" />
                                <TextBlock Text="我的连接" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Favorites, Mode=TwoWay}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationPage.Favorites}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Favorite}" Style="{StaticResource IconText}" Width="20" />
                                <TextBlock Text="收藏" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Recent, Mode=TwoWay}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationPage.Recent}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Recent}" Style="{StaticResource IconText}" Width="20" />
                                <TextBlock Text="最近连接" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Border Style="{StaticResource Surface.Divider}" Margin="18,10" />

                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Credentials, Mode=TwoWay}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationPage.Credentials}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Credential}" Style="{StaticResource IconText}" Width="20" />
                                <TextBlock Text="凭据" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=ImportExport, Mode=TwoWay}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationPage.ImportExport}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.ImportExport}" Style="{StaticResource IconText}" Width="20" />
                                <TextBlock Text="导入 / 导出" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Settings, Mode=TwoWay}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:NavigationPage.Settings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Settings}" Style="{StaticResource IconText}" Width="20" />
                                <TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 会话状态 -->
                    <Border Grid.Row="1" Margin="12,8,12,12" Padding="12,10"
                            Background="{DynamicResource Bg.Layer}"
                            CornerRadius="{StaticResource Radius.Medium}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Status.Idle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tabs.Count}" Value="1">
                                                <Setter Property="Fill" Value="{DynamicResource Status.Idle}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding SessionStatusText}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── 中央工作区 ────────────────────────────────── -->
                <Grid Grid.Column="1" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <!-- Auto：Tab 栏 Collapsed 时该行自然收为 0，全屏把整块屏幕
                             让给远程画面；会话工具条（带「退出全屏」按钮）保留为退出入口。 -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tab 栏。非全屏时始终在列，用户随时能从会话回到连接列表 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource Bg.Base}"
                            Padding="8,6,8,0"
                            Visibility="{Binding IsSessionFullScreen, Converter={StaticResource InverseBoolToVisibility}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource WorkspaceTabHeader}"
                                                     IsChecked="{Binding IsActive, Mode=OneWay}"
                                                     Checked="OnTabHeaderChecked"
                                                     ContextMenuOpening="OnTabContextMenuOpening">
                                            <RadioButton.ContextMenu>
                                                <!-- 仅会话 Tab 生效；首页 Tab 由 OnTabContextMenuOpening 拦掉。
                                                     动作统一用 Click 在代码后置分发。 -->
                                                <ContextMenu>
                                                    <MenuItem Header="重新连接" Click="OnTabReconnectClick" />
                                                    <Separator />
                                                    <MenuItem Header="关闭会话" InputGestureText="Ctrl+W" Click="OnTabCloseClick" />
                                                    <MenuItem Header="关闭其他会话" Click="OnTabCloseOthersClick" />
                                                    <MenuItem Header="关闭全部会话" Click="OnTabCloseAllClick" />
                                                </ContextMenu>
                                            </RadioButton.ContextMenu>
                                            <StackPanel Orientation="Horizontal" Margin="12,0,8,0">
                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Text.Secondary}" />
                                                <TextBlock Text="{Binding Title}"
                                                           Margin="8,0,0,0"
                                                           MaxWidth="150"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Text.Primary}" />

                                                <!-- 会话状态点：与状态文字一起出现在 Tab 提示中 -->
                                                <Ellipse Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center"
                                                         Fill="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}">
                                                    <Ellipse.Visibility>
                                                        <Binding Path="CanClose" Converter="{StaticResource BoolToVisibility}" />
                                                    </Ellipse.Visibility>
                                                    <Ellipse.ToolTip>
                                                        <ToolTip Content="{Binding StateText}" />
                                                    </Ellipse.ToolTip>
                                                </Ellipse>

                                                <Button Style="{StaticResource Button.Icon}"
                                                        Width="26" Height="26" Margin="6,0,-2,0"
                                                        FontSize="11"
                                                        Content="{StaticResource Icon.Close}"
                                                        ToolTip="关闭会话 (Ctrl+W)"
                                                        Command="{Binding CloseCommand}"
                                                        Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 内容区：所有 Tab 内容常驻，仅切换可见性，保证会话不被销毁 -->
                    <Border Grid.Row="1" Background="{DynamicResource Bg.Layer}" CornerRadius="8,8,0,0">
                      <Grid>
                        <!-- 页面数据加载失败横幅：静默失败会让用户对着空白页发懵 -->
                        <Border Panel.ZIndex="20"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Bg.Subtle}"
                                BorderBrush="{DynamicResource Status.Warning}"
                                BorderThickness="0,0,0,2"
                                Padding="16,10"
                                Visibility="{Binding PageLoadError.Length, Converter={StaticResource CountToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{StaticResource Icon.Warning}"
                                           FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource Status.Warning}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PageLoadError}"
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="10,0,12,0" />
                                <Button Grid.Column="2" Style="{StaticResource Button.Secondary}"
                                        Content="重试" VerticalAlignment="Center"
                                        Command="{Binding RetryPageLoadCommand}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type vm:PageTabViewModel}">
                                    <ContentControl Content="{Binding Page}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type vm:SessionTabViewModel}">
                                    <sessions:SessionHostView />
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                      </Grid>
                    </Border>
                </Grid>

                <!-- ── 右侧详情面板：选中连接时显示，全屏会话时收起 ── -->
                <Border Grid.Column="2"
                        Width="304"
                        Background="{DynamicResource Bg.Sidebar}"
                        BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="1,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!-- 详情面板只在连接列表页出现：窗口够宽、未全屏、且当前不是会话 Tab -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDetailPanelVisible}" Value="True" />
                                        <Condition Binding="{Binding IsSessionFullScreen}" Value="False" />
                                        <Condition Binding="{Binding IsSessionSelected}" Value="False" />
                                        <Condition Binding="{Binding IsConnectionListPage}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <pages:ConnectionDetailPanel DataContext="{Binding ConnectionsPage}" />
                </Border>
            </Grid>

            <!-- ══ 状态栏 ══════════════════════════════════════════ -->
            <Border Grid.Row="2" Height="26" Background="{DynamicResource Bg.Base}"
                    Visibility="{Binding IsSessionFullScreen, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid Margin="16,0">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="{Binding SessionStatusText}"
                               HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="本地优先 · 凭据由 Windows DPAPI 保护"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
