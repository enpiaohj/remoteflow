<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RemoteFlow.Infrastructure —— SQLite 持久化、应用设置、日志。
    保持平台无关（net10.0），供 Windows 与 macOS 两端共用。
    依赖 Windows 专属 API 的 DpapiCredentialVault 已剥离到
    RemoteFlow.Infrastructure.Windows；macOS 侧由 Keychain 实现对应能力。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteFlow.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteFlow.Core\RemoteFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

</Project>
