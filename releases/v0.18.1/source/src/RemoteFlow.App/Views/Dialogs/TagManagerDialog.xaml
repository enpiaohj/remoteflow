<Window x:Class="RemoteFlow.App.Views.Dialogs.TagManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
        xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextElement.Foreground="{DynamicResource Text.Primary}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ColorStringToBrushConverter x:Key="ColorToBrush" />
    </Window.Resources>

    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <Grid Margin="24,22,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Tag}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="17"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brand.Default}" />
                    <TextBlock Text="标签管理" Style="{StaticResource Text.SectionTitle}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource Button.Primary}"
                        Content="+ 新建标签"
                        Command="{Binding AddTagCommand}" />
            </Grid>

            <Border Margin="24,14,20,0" MaxHeight="360">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TagRowViewModel}">
                                <Grid Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                                             Fill="{Binding Color, Converter={StaticResource ColorToBrush}}" />

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}"
                                            Width="28" Height="28" FontSize="12"
                                            Content="{StaticResource Icon.Edit}"
                                            ToolTip="编辑标签"
                                            Command="{Binding DataContext.EditTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Style="{StaticResource Button.Icon}"
                                            Width="28" Height="28" FontSize="12" Margin="4,0,0,0"
                                            Content="{StaticResource Icon.Delete}"
                                            Foreground="{DynamicResource Status.Danger}"
                                            ToolTip="删除标签"
                                            Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Text="还没有标签，点右上角新建一个。"
                       Style="{StaticResource Text.BodySecondary}"
                       Margin="24,14,20,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <Border Background="{DynamicResource Bg.Subtle}"
                    CornerRadius="0,0,11,11"
                    Margin="0,20,0,0"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="关闭"
                            IsCancel="True"
                            IsDefault="True"
                            Click="OnCloseClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
