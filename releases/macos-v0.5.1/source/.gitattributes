## 统一换行：仓库内文本文件以 LF 存储，检出时按平台转换
* text=auto

## Windows 生态文件强制 CRLF
*.sln    text eol=crlf
*.slnx   text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf
*.manifest text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

## 源代码与文档保持 LF
*.cs     text eol=lf
*.xaml   text eol=lf diff=xml
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf

## 二进制资源
*.png    binary
*.jpg    binary
*.ico    binary
*.dll    binary
*.exe    binary
*.pdb    binary
*.zip    binary
*.docx   binary
*.pptx   binary
*.xlsx   binary
*.bundle binary
