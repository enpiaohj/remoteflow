<Window x:Class="RemoteFlow.App.Views.Dialogs.TagEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextElement.Foreground="{DynamicResource Text.Primary}">

    <Border Background="{DynamicResource Bg.Layer}"
            BorderBrush="{DynamicResource Stroke.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" Direction="270" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Margin="28,26,28,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Tag}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="17"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brand.Default}" />
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource Text.SectionTitle}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="名称" Style="{StaticResource Text.Caption}" Margin="0,16,0,6" />
                <TextBox x:Name="NameInput"
                         Style="{StaticResource Input.TextBox}"
                         MaxLength="30" />

                <TextBlock Text="颜色" Style="{StaticResource Text.Caption}" Margin="0,14,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="SwatchList" Grid.Column="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                            VerticalAlignment="Center" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource Stroke.Default}" BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush x:Name="PreviewBrush" Color="#0F6CBD" />
                        </Border.Background>
                    </Border>
                </Grid>

                <TextBlock Text="自定义 #RRGGBB（可选）" Style="{StaticResource Text.Caption}" Margin="0,10,0,6" />
                <TextBox x:Name="ColorInput"
                         Style="{StaticResource Input.TextBox}"
                         FontFamily="{StaticResource MonoFont}"
                         MaxLength="7"
                         TextChanged="OnColorInputChanged" />

                <TextBlock Text="描述（可选）" Style="{StaticResource Text.Caption}" Margin="0,14,0,6" />
                <TextBox x:Name="DescriptionInput"
                         Style="{StaticResource Input.TextBox}"
                         MaxLength="80" />

                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Status.Danger}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <Border Background="{DynamicResource Bg.Subtle}"
                    CornerRadius="0,0,11,11"
                    Margin="0,24,0,0"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="取消"
                            IsCancel="True"
                            Click="OnCancelClick" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="确定"
                            IsDefault="True"
                            Margin="8,0,0,0"
                            Click="OnConfirmClick" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
