<UserControl x:Class="RemoteFlow.App.Views.Sessions.SessionHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SessionTabViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />

        <!-- 悬浮条上的紧凑图标按钮 -->
        <Style x:Key="Session.BarButton" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource Bg.Session}">

        <!-- ══ 会话内容 ═════════════════════════════════════════════ -->
        <Grid>
            <!-- 协议视图由代码后置按会话类型注入；必须拉伸填满，否则全屏后
                 RDP/VNC 画面会缩在左上角、四周留黑边。 -->
            <ContentControl x:Name="SessionContent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

            <!-- 质量详情 Flyout 的定位锚：标题栏工具条的状态入口点击后，Flyout 弹在此下方 -->
            <Border x:Name="QualityFlyoutAnchor"
                    Height="1" Width="120"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,2,0,0" />

            <!-- 连接中：轻量遮罩，不打断用户 -->
            <Border Background="{DynamicResource Bg.Session}"
                    Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Profile.Name}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#E6E6E6"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0">
                        <Run Text="{Binding StateText, Mode=OneWay}" />
                        <Run Text="  " />
                        <Run Text="{Binding Profile.Host, Mode=OneWay}" />
                    </TextBlock>
                    <ProgressBar IsIndeterminate="True"
                                 Width="180" Height="2"
                                 Margin="0,18,0,0"
                                 Background="#2E2E2E"
                                 Foreground="{DynamicResource Brand.Default}"
                                 BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- 断线 / 失败：会话内部状态层 + 重新连接，不弹模态错误框 -->
            <Border Background="#D9141414"
                    Visibility="{Binding IsInterrupted, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Surface.Card}"
                        MaxWidth="440"
                        Padding="28,24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StateIcon}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}" />
                            <TextBlock Text="{Binding StateText}"
                                       Style="{StaticResource Text.SectionTitle}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding InterruptionMessage}"
                                   Style="{StaticResource Text.BodySecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Secondary}"
                                    Content="关闭会话"
                                    Command="{Binding CloseCommand}" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Content="重新连接"
                                    Margin="8,0,0,0"
                                    Command="{Binding ReconnectCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ══ 悬浮药丸工具条（仅全屏）════════════════════════════════
             全屏隐藏了应用标题栏与 Tab 栏，这条药丸承担会话切换、窗口控制、
             退出全屏。RDP 会话内嵌原生 ActiveX（airspace），普通 WPF 浮层会被
             它盖住、也收不到其上的鼠标事件；用 Popup（独立顶层窗口）承载，
             顶沿唤出由代码后置轮询光标实现。整条可拖动。 -->
        <Popup x:Name="ToolbarPopup"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Relative"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               HorizontalOffset="0"
               VerticalOffset="0">
            <!-- 上边缘贴屏；四周留一点给投影，顶部不留（投影朝下）。
                 顶角切平、底角圆，呈现「从屏幕顶沿拉出」的连接条观感。 -->
            <Border x:Name="PillBar"
                    Margin="14,0,14,12"
                    Padding="4"
                    Background="{DynamicResource Bg.Layer}"
                    BorderBrush="{DynamicResource Stroke.Subtle}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,10,10"
                    MouseLeftButtonDown="OnToolbarDragStart"
                    MouseMove="OnToolbarDragMove"
                    MouseLeftButtonUp="OnToolbarDragEnd">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#000000" />
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- 会话切换 -->
                    <Button x:Name="SessionSwitchButton"
                            Style="{StaticResource Session.BarButton}"
                            Width="Auto"
                            Padding="8,0"
                            Click="OnSessionSwitchClick"
                            ToolTip="切换会话">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Sessions}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="12"
                                       MaxWidth="140"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="6,0,4,0" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 固定 / 取消固定 -->
                    <ToggleButton x:Name="PinToggle"
                                  Height="30" Width="30"
                                  Cursor="Hand"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Checked="OnPinChanged"
                                  Unchecked="OnPinChanged">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="{StaticResource Icon.Unpin}" />
                                <Setter Property="ToolTip" Value="固定工具条" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="{StaticResource Icon.Pin}" />
                                        <Setter Property="ToolTip" Value="取消固定（自动隐藏）" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brand.Default}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="13"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Border Width="1" Height="16" Margin="4,0"
                            Background="{DynamicResource Stroke.Default}" />

                    <!-- 状态入口：只有状态图标（对号）可点击打开质量详情；主机名只作展示，
                         不再是点击热区——药丸窄、拖动多，整块可点极易误触。 -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{Binding StateIcon}"
                                FontSize="12"
                                Foreground="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}"
                                Click="OnStatusEntryClick"
                                ToolTip="连接状态 · 查看质量详情" />
                        <TextBlock Text="{Binding Profile.Host}"
                                   Style="{StaticResource Text.Caption}"
                                   FontFamily="{StaticResource MonoFont}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Margin="5,0,3,0" />
                    </StackPanel>

                    <Border Width="1" Height="16" Margin="4,0"
                            Background="{DynamicResource Stroke.Default}" />

                    <StackPanel x:Name="RdpToolsPill" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Scale}"
                                ToolTip="缩放 / 适应窗口"
                                Command="{Binding ToggleScalingCommand}" />
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Keyboard}"
                                ToolTip="发送 Ctrl+Alt+Del"
                                Command="{Binding SendCtrlAltDeleteCommand}" />
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.TaskManager}"
                                ToolTip="启动任务管理器"
                                Command="{Binding SendTaskManagerCommand}" />
                    </StackPanel>

                    <StackPanel x:Name="SshToolsPill" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Copy}"
                                ToolTip="复制选中内容 (Ctrl+Shift+C)"
                                Command="{Binding CopySelectionCommand}" />
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Paste}"
                                ToolTip="粘贴 (Ctrl+Shift+V)"
                                Command="{Binding PasteClipboardCommand}" />
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Clear}"
                                ToolTip="清屏"
                                Command="{Binding ClearTerminalCommand}" />
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Search}"
                                ToolTip="在输出中查找"
                                Command="{Binding SearchTerminalCommand}" />
                    </StackPanel>

                    <StackPanel x:Name="VncToolsPill" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Session.BarButton}"
                                Content="{StaticResource Icon.Scale}"
                                ToolTip="{Binding VncScalingLabel}"
                                Command="{Binding CycleVncScalingCommand}" />
                    </StackPanel>

                    <Border Width="1" Height="16" Margin="4,0"
                            Background="{DynamicResource Stroke.Default}" />

                    <Button Style="{StaticResource Session.BarButton}"
                            Content="{StaticResource Icon.WindowMinimize}"
                            ToolTip="最小化窗口"
                            Click="OnMinimizeWindow" />

                    <!-- 完全全屏开关：窗口最大化 ↔ 完全全屏。图标与提示随档位切换，
                         从不禁用、从不隐藏（对齐 macOS 药丸的同类按钮）。 -->
                    <Button x:Name="ScreenFullButton"
                            Style="{StaticResource Session.BarButton}"
                            Content="{StaticResource Icon.FullScreen}"
                            ToolTip="完全全屏 (F11)"
                            Command="{Binding ToggleScreenFullCommand}" />

                    <Button Command="{Binding ExitFullScreenCommand}"
                            Style="{StaticResource Session.BarButton}"
                            Content="{StaticResource Icon.WindowRestore}"
                            ToolTip="退出全屏（回到常规）" />

                    <Button Style="{StaticResource Session.BarButton}"
                            Content="{StaticResource Icon.Close}"
                            ToolTip="关闭会话 (Ctrl+W)"
                            Command="{Binding CloseCommand}" />

                    <!-- 首次进全屏的一次性提示：工具条会自动隐藏，鼠标移到顶部再唤出 -->
                    <Border x:Name="FullScreenHint"
                            Visibility="Collapsed"
                            Margin="8,0,2,0"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brand.Default}"
                            CornerRadius="5">
                        <TextBlock Text="工具条会自动隐藏 · 鼠标移到顶部区域再唤出"
                                   FontSize="11"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
