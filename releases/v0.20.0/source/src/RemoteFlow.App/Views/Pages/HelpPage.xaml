<UserControl x:Class="RemoteFlow.App.Views.Pages.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HelpPageViewModel}">

    <UserControl.Resources>
        <!-- 指南正文：换行 + 段距 + 行高。强调词用 Run.SemiBold。 -->
        <Style x:Key="Help.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="LineHeight" Value="21" />
        </Style>

        <!-- 章节图标瓦片：Brand.Subtle 底 + 品牌色图标，同首页设备 Tile 的语言 -->
        <Style x:Key="Help.Tile" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Brand.Subtle}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- 步骤数字徽章 -->
        <Style x:Key="Help.Step" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource Brand.Default}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- 协议 / 档位小标签（pill） -->
        <Style x:Key="Help.Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 行内强调（SemiBold + 前景色），包在 Help.Body 的 Run 里用 -->
        <Style x:Key="Help.Strong" TargetType="Run">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
    </UserControl.Resources>

    <!-- 与设置页同款根 margin -->
    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="使用指南" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="从新建连接到三档全屏，RemoteFlow 的常用操作都在这里。"
                       Style="{StaticResource Text.BodySecondary}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,20">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                <!-- ══ 快速上手 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Help.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.Connect}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="快速上手" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Help.Step}" Margin="0,1,10,0">
                                    <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource Help.Body}">
                                    <Run Text="点顶部" /><Run Text="「新建连接」" Style="{StaticResource Help.Strong}" />
                                    <Run Text="（或" /><Run Text="Ctrl+N" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                    <Run Text="）：填写名称、主机、端口，选择协议（RDP / SSH / VNC）与凭据，保存。" />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Help.Step}" Margin="0,1,10,0">
                                    <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource Help.Body}">
                                    <Run Text="在" /><Run Text="「首页」" Style="{StaticResource Help.Strong}" /><Run Text="或" />
                                    <Run Text="「我的连接」" Style="{StaticResource Help.Strong}" />
                                    <Run Text="点设备行（或右键 → 连接）发起连接；会话以标签页形式在顶部打开。" />
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Help.Step}" Margin="0,1,10,0">
                                    <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource Help.Body}">
                                    <Run Text="Ctrl+K" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                    <Run Text="聚焦全局搜索：按名称、IP、标签、备注快速定位设备。" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 连接管理 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Help.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.Connections}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="连接管理" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Help.Body}">
                                <Run Text="「我的连接」" Style="{StaticResource Help.Strong}" />
                                <Run Text="按分组组织：右键分组可管理分组；右键连接可 连接 / 编辑 / 测试连接 / 收藏 / 移动到分组。从分组菜单新建连接时会预选该分组。" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Help.Body}">
                                <Run Text="「收藏」" Style="{StaticResource Help.Strong}" />
                                <Run Text="汇总常用设备；" /><Run Text="「最近连接」" Style="{StaticResource Help.Strong}" />
                                <Run Text="按时间回溯，附连接历史与结果。" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Help.Body}" Margin="0">
                                <Run Text="凭据集中管理，支持" /><Run Text="密码" Style="{StaticResource Help.Strong}" />
                                <Run Text="与" /><Run Text="SSH 密钥" Style="{StaticResource Help.Strong}" />
                                <Run Text="两类，供多个连接复用。" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 会话操作 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Help.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.Sessions}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="会话操作" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Help.Body}">
                                <Run Text="会话顶部常驻工具条：左侧是连接状态（点开查看质量详情）与主机名；右侧是协议相关操作。" />
                            </TextBlock>

                            <!-- 协议三行：行首协议色 pill，同首页卡片的色彩语言 -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Help.Chip}" Margin="0,0,10,0">
                                    <TextBlock Text="RDP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Protocol.Rdp}" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource Help.Body}" VerticalAlignment="Center"
                                           Text="缩放 / 适应窗口、发送 Ctrl+Alt+Del、启动任务管理器。" />
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Help.Chip}" Margin="0,0,10,0">
                                    <TextBlock Text="SSH" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Protocol.Ssh}" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource Help.Body}" VerticalAlignment="Center"
                                           Text="复制选中（Ctrl+Shift+C）、粘贴（Ctrl+Shift+V）、清屏、在输出中查找。" />
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Help.Chip}" Margin="0,0,10,0">
                                    <TextBlock Text="VNC" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Protocol.Vnc}" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource Help.Body}" VerticalAlignment="Center"
                                           Text="等比适应 / 拉伸铺满 / 1:1 三档缩放。" />
                            </Grid>

                            <TextBlock Style="{StaticResource Help.Body}" Margin="0,8,0,8">
                                <Run Text="标签页：" /><Run Text="Ctrl+W" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                <Run Text="关闭当前会话，" /><Run Text="Ctrl+Tab" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                <Run Text="往复切换；标签右键可关闭其他 / 右侧会话。" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Help.Body}" Margin="0">
                                <Run Text="断线时会话内出现轻量状态层，可一键重新连接；自动重连期间无需手动干预。" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 三档全屏与 F11 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Help.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.FullScreen}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="三档全屏与 F11" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />

                            <!-- 三档可视化：pill 链 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource Help.Chip}">
                                    <TextBlock Text="常规" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" />
                                </Border>
                                <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Help.Chip}">
                                    <TextBlock Text="窗口最大化" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" />
                                </Border>
                                <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Help.Chip}">
                                    <TextBlock Text="完全全屏" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" />
                                </Border>
                                <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource Text.Tertiary}" Margin="8,0" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Help.Chip}">
                                    <TextBlock Text="常规" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" />
                                </Border>
                                <Border Background="{DynamicResource Brand.Subtle}" CornerRadius="{StaticResource Radius.Pill}"
                                        Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="F11" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brand.Default}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Help.Body}">
                                <Run Text="窗口最大化" Style="{StaticResource Help.Strong}" />
                                <Run Text="保留标题栏，收起侧栏 / 标签栏 / 详情 / 状态栏；" />
                                <Run Text="完全全屏" Style="{StaticResource Help.Strong}" />
                                <Run Text="无边框铺满整块显示器。" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Help.Body}">
                                <Run Text="常驻工具条右侧也有「窗口最大化」与直达「完全全屏」两颗按钮。" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Help.Body}" Margin="0">
                                <Run Text="全屏档下顶部出现" /><Run Text="悬浮药丸" Style="{StaticResource Help.Strong}" />
                                <Run Text="：切换会话、固定 / 自动隐藏、连接状态、最小化、完全全屏开关、退出全屏（无论当前哪一档，一路回到常规）、关闭会话。药丸可拖动；自动隐藏后鼠标移到顶部区域唤出。" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 凭据与安全 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Help.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.Shield}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="凭据与安全" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Help.Body}">
                                <Run Text="密码 / 私钥由 " /><Run Text="Windows DPAPI" Style="{StaticResource Help.Strong}" />
                                <Run Text=" 加密后存入本机数据库；日志、导出文件与异常消息中都不会出现明文 Secret。" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Help.Body}">
                                <Run Text="SSH 首次连接记录" /><Run Text="主机密钥指纹" Style="{StaticResource Help.Strong}" />
                                <Run Text="；指纹变化时强警告并要求确认，绝不静默接受。" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Help.Body}" Margin="0">
                                <Run Text="支持加密备份凭据（" /><Run Text=".rfbackup" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                <Run Text="，AES-256-GCM），用于迁移或灾备。" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 数据与备份 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Help.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.Database}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="数据与备份" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Help.Body}">
                                <Run Text="所有数据保存在本机 SQLite。" />
                                <Run Text="设置 →「数据与备份」" Style="{StaticResource Help.Strong}" />
                                <Run Text="提供：导入连接 CSV、导出连接 CSV（不含密码）、凭据加密备份。" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Help.Body}" Margin="0">
                                <Run Text="启动时数据库若异常会自动尝试修复恢复。" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 云同步 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Help.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.Refresh}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="云同步（AppsCloud）" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Help.Body}">
                                <Run Text="设置 →「云同步」" Style="{StaticResource Help.Strong}" />
                                <Run Text="：登录 / 配对你自己的 AppsCloud 服务器后，连接与凭据可跨设备同步。" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Help.Body}" Margin="0">
                                <Run Text="开启「新设备需批准」时，新设备需在另一台已登录设备上批准（设置 → 云同步 → 待批准的设备），或使用 " />
                                <Run Text="Recovery Key" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" />
                                <Run Text=" 恢复。" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 快捷键速查 ══ -->
                <Border Style="{StaticResource Surface.Card}" Padding="20,18" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Help.Tile}" Margin="0,0,14,0">
                            <TextBlock Text="{StaticResource Icon.Keyboard}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="{DynamicResource Brand.Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="快捷键速查" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Kbd}"><TextBlock Text="Ctrl K" Style="{StaticResource Text.Label}" /></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="聚焦全局搜索" Style="{StaticResource Text.Body}" Margin="10,0,0,0" VerticalAlignment="Center" />

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Kbd}" Margin="0,8,0,0"><TextBlock Text="Ctrl N" Style="{StaticResource Text.Label}" /></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="新建连接" Style="{StaticResource Text.Body}" Margin="10,8,0,0" VerticalAlignment="Center" />

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Kbd}" Margin="0,8,0,0"><TextBlock Text="Ctrl W" Style="{StaticResource Text.Label}" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="关闭当前会话标签" Style="{StaticResource Text.Body}" Margin="10,8,0,0" VerticalAlignment="Center" />

                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource Kbd}" Margin="0,8,0,0"><TextBlock Text="Ctrl Tab" Style="{StaticResource Text.Label}" /></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="切换会话标签" Style="{StaticResource Text.Body}" Margin="10,8,0,0" VerticalAlignment="Center" />

                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource Kbd}" Margin="0,8,0,0"><TextBlock Text="F11" Style="{StaticResource Text.Label}" /></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="会话全屏 / 逐档切换" Style="{StaticResource Text.Body}" Margin="10,8,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
