<UserControl x:Class="RemoteFlow.App.Views.Pages.CredentialsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CredentialsPageViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />

        <!-- 顶部「多选」Toggle（低强调幽灵按钮；不能用 Button.* 样式，TargetType 不匹配会崩） -->
        <Style x:Key="MultiSelectToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0" CornerRadius="{StaticResource Radius.Medium}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brand.Default}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="CredentialRowMenu" x:Shared="False">
            <MenuItem Header="编辑" Click="OnEditMenuClick" />
            <Separator />
            <MenuItem Header="删除" Click="OnDeleteMenuClick" />
        </ContextMenu>

        <!-- 行高交给行模板（Grid Height），这里不写死，否则更高的行会被裁掉 -->
        <Style x:Key="CredentialRow" TargetType="ListBoxItem" BasedOn="{StaticResource List.Row}">
            <Setter Property="ContextMenu" Value="{StaticResource CredentialRowMenu}" />
            <EventSetter Event="ContextMenuOpening" Handler="OnRowContextMenuOpening" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="凭据" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="10" Padding="8,2" Margin="10,2,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding Items.Count}" Style="{StaticResource Text.Caption}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ToggleButton Style="{StaticResource MultiSelectToggle}"
                              IsChecked="{Binding IsMultiSelect}"
                              ToolTip="多选：可批量删除所选凭据">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Accept}" FontFamily="{StaticResource IconFont}"
                                   FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="多选" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource Button.Icon}"
                        Content="{StaticResource Icon.Refresh}"
                        ToolTip="刷新"
                        Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource Button.Primary}"
                        MinHeight="32"
                        Padding="14,0"
                        Margin="8,0,0,0"
                        Command="{Binding CreateCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Add}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="新建凭据" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 搜索 + 类型筛选：同一行 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Height="34"
                    Background="{DynamicResource Bg.Layer}"
                    BorderBrush="{DynamicResource Stroke.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{StaticResource Icon.Search}"
                               FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource Text.Tertiary}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             Background="Transparent" BorderThickness="0"
                             FontSize="13" VerticalContentAlignment="Center" Margin="8,0,10,0" />
                    <TextBlock Grid.Column="1" IsHitTestVisible="False"
                               Text="搜索凭据名称、用户名或类型…"
                               Foreground="{DynamicResource Text.Tertiary}" FontSize="13"
                               VerticalAlignment="Center" Margin="9,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 类型筛选：只显示 Label；Value 仅供内部筛选 -->
            <ComboBox Grid.Column="1" Style="{StaticResource Input.ComboBox}" MinWidth="150" Height="34"
                      Margin="8,0,0,0" VerticalAlignment="Center"
                      ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding TypeOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- DPAPI 加密说明：一行 + 悬停展开细节 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,0,12"
                    ToolTipService.InitialShowDelay="200">
            <TextBlock Text="{StaticResource Icon.Shield}"
                       FontFamily="{StaticResource IconFont}" FontSize="13"
                       Foreground="{DynamicResource Status.Success}" VerticalAlignment="Center" />
            <TextBlock Text="凭据由 Windows DPAPI 加密保护"
                       Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{StaticResource Icon.Info}"
                       FontFamily="{StaticResource IconFont}" FontSize="12"
                       Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" Margin="6,0,0,0" />
            <StackPanel.ToolTip>
                <ToolTip MaxWidth="360">
                    <TextBlock TextWrapping="Wrap"
                               Text="密码与私钥由 Windows DPAPI 加密后保存在独立的保险库文件（vault.dat）中，不写入连接数据库，也不随连接导出文件带走。只能在当前 Windows 账户下解密。界面不会显示任何已保存的 Secret 明文。" />
                </ToolTip>
            </StackPanel.ToolTip>
        </StackPanel>

        <!-- 表格卡片 -->
        <Border Grid.Row="3" Style="{StaticResource Surface.Card}" Padding="8,4" Margin="0,0,0,0"
                Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 多选状态条：未勾选只给提示；勾选 ≥1 才出现批量操作 -->
                <Grid Grid.Row="0" MinHeight="34" Margin="6,0,6,8"
                      Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVisibility}}">

                    <!-- 已勾选 ≥1：已选择 N 项 · 取消选择 | 更改类型 …… 删除 -->
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="{Binding SelectionSummary}" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Subtle}" MinHeight="24" Padding="6,0"
                                Margin="10,0,0,0" Content="取消选择" FontSize="12" VerticalAlignment="Center"
                                Command="{Binding ClearSelectionCommand}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Secondary}" MinHeight="28" Padding="10,0"
                                    FontSize="12" Content="更改类型" Click="OnChangeTypeClick" />
                            <Button Style="{StaticResource Button.Secondary}" MinHeight="28" Padding="10,0"
                                    Margin="10,0,0,0" FontSize="12" Content="删除" Foreground="{DynamicResource Status.Danger}"
                                    Command="{Binding DeleteSelectedCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 未勾选：提示 + 退出 -->
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.BodySecondary}" FontSize="12"
                                   VerticalAlignment="Center" Text="选择需要批量操作的凭据" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                Content="{StaticResource Icon.Close}" ToolTip="退出多选"
                                Command="{Binding ExitMultiSelectCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- 列头 -->
                <Grid Grid.Row="1" Height="34" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <!-- 名称按内容伸缩、封顶；中间列紧凑靠左；* 空列吸掉多余宽度；操作固定在最右 -->
                        <ColumnDefinition Width="Auto" MinWidth="240" MaxWidth="440" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource Text.Label}" Margin="40,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="用户名" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="保险库" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="引用" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Stroke.Subtle}" Margin="6,0" />

                <ListBox Grid.Row="2" x:Name="CredentialList"
                         Style="{StaticResource List.Plain}"
                         ItemContainerStyle="{StaticResource CredentialRow}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Margin="0,2,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CredentialItemViewModel}">
                            <Grid Height="44" Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="240" MaxWidth="440" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                </Grid.ColumnDefinitions>

                                <!-- 名称 + 头像 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 多选模式下的行勾选框 -->
                                    <CheckBox Width="26" Height="26" Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Click="OnRowCheckBoxClick"
                                              Tag="{Binding}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <!-- 图标 28 规格，与连接工作台设备行一致（44 保留给首页大卡片） -->
                                    <Grid Width="28" Height="28">
                                        <Border CornerRadius="14"
                                                Background="{Binding TypeAccentBrushKey, Converter={StaticResource KeyToBrush}}"
                                                Opacity="{StaticResource IconTile.ColorBgOpacity}" />
                                        <TextBlock Text="{Binding TypeIcon}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding TypeAccentBrushKey, Converter={StaticResource KeyToBrush}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontSize="12"
                                               Margin="10,0,8,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- 类型徽章 -->
                                <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border CornerRadius="4"
                                            Background="{Binding TypeAccentBrushKey, Converter={StaticResource KeyToBrush}}"
                                            Opacity="0.14" />
                                    <TextBlock Text="{Binding TypeName}" FontSize="11" Margin="8,3"
                                               Foreground="{Binding TypeAccentBrushKey, Converter={StaticResource KeyToBrush}}" />
                                </Grid>

                                <TextBlock Grid.Column="2" Text="{Binding Username}"
                                           Style="{StaticResource Text.BodySecondary}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                            ToolTip="{Binding SecretStateDisplay}">
                                    <TextBlock Text="{StaticResource Icon.Lock}"
                                               FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSecret}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Secret 已保存时不显示文字（每行都一样是噪声），缺失时才提示「未保存密码/私钥」 -->
                                    <TextBlock Text="{Binding SecretStateDisplay}" Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Status.Warning}"
                                               Visibility="{Binding HasSecret, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="4" Text="{Binding UsageDisplay}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Style.Triggers>
                                                <!-- 未被任何连接引用的孤儿凭据用静音警告色，一眼可辨 -->
                                                <DataTrigger Binding="{Binding UsageCount}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.Icon}"
                                            Width="30" Height="30" FontSize="13"
                                            Content="{StaticResource Icon.Edit}"
                                            ToolTip="编辑"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}"
                                            Width="30" Height="30" FontSize="13"
                                            Content="{StaticResource Icon.Delete}"
                                            ToolTip="删除"
                                            Foreground="{DynamicResource Status.Danger}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 筛选无结果 -->
                <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Style="{StaticResource Text.BodySecondary}"
                           Text="没有匹配的凭据。"
                           Visibility="{Binding HasNoMatch, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- 空状态 -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Bg.Subtle}" HorizontalAlignment="Center">
                <TextBlock Text="{StaticResource Icon.Credential}"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="24"
                           Foreground="{DynamicResource Text.Tertiary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Style="{StaticResource Text.BodySecondary}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"
                       Text="还没有凭据。把常用账号建成凭据后，多台主机可以共用同一份账号信息，改密时只需更新一次。" />
            <Button Style="{StaticResource Button.Primary}" Content="新建凭据"
                    HorizontalAlignment="Center" Margin="0,20,0,0"
                    Command="{Binding CreateCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
