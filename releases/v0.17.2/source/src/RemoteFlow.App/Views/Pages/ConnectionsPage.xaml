<UserControl x:Class="RemoteFlow.App.Views.Pages.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteFlow.App.Converters"
             xmlns:vm="clr-namespace:RemoteFlow.Presentation.ViewModels;assembly=RemoteFlow.Presentation"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionsPageViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
        <conv:ColorStringToBrushConverter x:Key="ColorToBrush" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:EnumDisplayNameConverter x:Key="EnumDisplay" />
        <conv:IsGroupNodeConverter x:Key="IsGroupNode" />
        <conv:DepthToMarginConverter x:Key="DepthToMargin" />

        <!-- 顶部「多选」Toggle 的样式。注意不能用 Button.* 系列（TargetType=Button），
             否则应用到 ToggleButton 上会抛 “TargetType does not match” 运行时异常崩溃。 -->
        <Style x:Key="MultiSelectToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="12" />
            <!-- 低强调的“幽灵”按钮：无边框盒、次级文字；让「+ 新建连接」保持唯一 Primary。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius.Medium}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brand.Default}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 连接行的右键 / 「更多」菜单。ContextMenu 不在主可视树内，
             菜单项动作统一用 Click 在代码后置分发（ResolveItem 从 DataContext 取行 VM）。
             分组布局：主操作组=连接(无活动)/切换到会话+断开连接(有活动) + 编辑；
             第二组=测试连接与收藏切换（我的连接里夹着复制连接）；
             第三组按视图裁切——「我的连接」（Filter=All）放 移动到分组 / 删除，
             收藏 / 最近连接快捷视图放「管理连接」。
             connect / disconnect 项 Header 与显隐在 OnRowContextMenuOpened 按行会话状态守卫；
             收藏项 Header 按视图与行状态设为 收藏 / 取消收藏；
             被隐藏项夹出的空分隔组由 NormalizeSeparators 一并隐藏（菜单 Tag 定位）。 -->
        <ContextMenu x:Key="ConnectionRowMenu" x:Shared="False" Opened="OnRowContextMenuOpened">
            <!-- 主操作组首项按行会话状态在守卫里改名：无活动=「连接」；有活动=「切换到会话」；
                 同时按状态显隐第二项「断开连接」（连接行与首页快捷菜单同一套约定）。 -->
            <MenuItem Tag="connect" Header="连接" InputGestureText="Enter" Click="OnConnectMenuClick" />
            <MenuItem Tag="disconnect" Header="断开连接" Click="OnDisconnectMenuClick" />
            <MenuItem Tag="edit" Header="编辑" Click="OnEditMenuClick" />
            <Separator />
            <MenuItem Tag="duplicate" Header="复制连接" Click="OnDuplicateMenuClick" />
            <MenuItem Tag="test" Header="测试连接" Click="OnTestMenuClick" />
            <!-- 收藏 / 取消收藏：Header 随行当前收藏状态切换，打开时由守卫写入 -->
            <MenuItem Tag="favorite" Header="收藏" IsCheckable="True"
                      IsChecked="{Binding IsFavorite, Mode=OneWay}"
                      Click="OnToggleFavoriteMenuClick" />
            <Separator />
            <MenuItem Tag="move" Header="移动到分组" SubmenuOpened="OnMoveToGroupSubmenuOpened">
                <MenuItem Header="加载分组…" IsEnabled="False" />
            </MenuItem>
            <MenuItem Tag="delete" Header="删除" Click="OnDeleteMenuClick" />
            <MenuItem Tag="locate" Header="管理连接" Click="OnLocateMenuClick" />
        </ContextMenu>

        <ContextMenu x:Key="GroupMenu" x:Shared="False" Opened="OnGroupContextMenuOpened">
            <MenuItem Header="新建连接" Click="OnGroupNewConnectionClick" />
            <MenuItem Header="新建子分组" Click="OnGroupNewChildClick" />
            <Separator />
            <MenuItem Tag="rename" Header="重命名" Click="OnGroupRenameClick" />
            <MenuItem Tag="setDefault" Header="设为默认分组" Click="OnGroupSetDefaultClick" />
            <Separator />
            <MenuItem Tag="delete" Header="删除分组" Click="OnGroupDeleteClick" />
        </ContextMenu>

        <Style x:Key="ConnectionRow" TargetType="ListBoxItem" BasedOn="{StaticResource List.Row}">
            <Setter Property="ContextMenu" Value="{StaticResource ConnectionRowMenu}" />
            <EventSetter Event="ContextMenuOpening" Handler="OnRowContextMenuOpening" />
        </Style>

        <!-- 混合行的容器样式：分组标题行不可选、不高亮；连接行沿用 List.Row -->
        <Style x:Key="GroupedRow" TargetType="ListBoxItem" BasedOn="{StaticResource List.Row}">
            <Setter Property="ContextMenu" Value="{StaticResource ConnectionRowMenu}" />
            <EventSetter Event="ContextMenuOpening" Handler="OnRowContextMenuOpening" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource IsGroupNode}}" Value="True">
                    <Setter Property="ContextMenu" Value="{x:Null}" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 连接行（分组视图与扁平视图共用）-->
        <DataTemplate x:Key="ConnRowTemplate" DataType="{x:Type vm:ConnectionItemViewModel}">
            <Grid Height="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="460" SharedSizeGroup="ColName" />
                    <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="ColHost" />
                    <ColumnDefinition Width="Auto" MinWidth="56" SharedSizeGroup="ColProto" />
                    <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="ColTags" />
                    <ColumnDefinition Width="*" MinWidth="24" />
                    <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="ColRecent" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <!-- 首列：普通模式=收藏星标；多选模式=勾选框，两者互斥交替 -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid Width="36" HorizontalAlignment="Left">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Button Width="28" Height="28" FontSize="14"
                                ToolTip="收藏 / 取消收藏"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                    <Setter Property="Content" Value="{StaticResource Icon.Favorite}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Content" Value="{StaticResource Icon.FavoriteFilled}" />
                                            <Setter Property="Foreground" Value="#F2C037" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <CheckBox Width="30" Height="30" HorizontalAlignment="Left" Margin="3,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                              Click="OnRowCheckBoxClick"
                              Tag="{Binding}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 设备图标与首页「收藏 / 最近活动」行同一套规格：44 彩色淡色底 Tile +
                         协议 Glyph，全应用含协议的设备行统一 -->
                    <Grid>
                        <Border Style="{StaticResource IconTile.Background}"
                                Background="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}"
                                Opacity="{StaticResource IconTile.ColorBgOpacity}" />
                        <TextBlock Style="{StaticResource IconTile.Glyph}"
                                   Text="{Binding ProtocolIcon}"
                                   Foreground="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}" />
                        <!-- 会话状态点（右下角）：空闲隐藏，连接中琥珀 / 已连接绿 -->
                        <Border Style="{StaticResource SessionStatusDot}"
                                Visibility="{Binding HasActiveSession, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Style="{StaticResource SessionStatusDot.Fill}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Margin="14,0,8,0"
                               MaxWidth="360" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding HostDisplay}" Style="{StaticResource Text.BodySecondary}"
                           FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                <!-- 协议徽章与首页一致：协议色小徽章，替代 A+ 时的裸文字列 -->
                <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0">
                    <Border CornerRadius="4"
                            Background="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}"
                            Opacity="0.14" />
                    <TextBlock Text="{Binding ProtocolName}" FontSize="10" Margin="7,2"
                               Foreground="{Binding ProtocolBrushKey, Converter={StaticResource KeyToBrush}}" />
                </Grid>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Margin="0,0,5,0"
                                        Background="{DynamicResource Bg.Subtle}"
                                        BorderBrush="{DynamicResource Stroke.Subtle}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Margin="6,3">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={StaticResource ColorToBrush}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="5,0,1,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   MaxWidth="80" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding OverflowTagCount, StringFormat=+{0}}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center"
                               Visibility="{Binding OverflowTagCount, Converter={StaticResource CountToVisibility}}" />
                </StackPanel>

                <!-- 悬停快捷操作：鼠标移到行上时在弹性列里就地浮出「连接」，省去双击 / 走详情面板。
                     多选模式下隐藏。 -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="IsHitTestVisible" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource Button.Subtle}" Height="28" Padding="10,0" FontSize="12"
                            Content="连接" ToolTip="连接 (Enter)"
                            Click="OnRowConnectClick" />
                </StackPanel>

                <!-- 「最近连接」列：真正已连接时显示绿点 +「已连接」，否则回退显示最近连接时间。
                     我的连接 / 收藏 / 最近连接三视图共用同一 ConnRowTemplate，行级实时状态全同步。 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{DynamicResource Status.Success}" />
                        <TextBlock Text="已连接" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Status.Success}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastConnectedDisplay}" Style="{StaticResource Text.Caption}"
                               Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>

                <Button Grid.Column="7" Style="{StaticResource Button.Icon}" Width="30" Height="30"
                        Content="{StaticResource Icon.More}" ToolTip="更多操作" Click="OnMoreClick" />
            </Grid>
        </DataTemplate>

        <!-- 分组标题行 -->
        <DataTemplate x:Key="GroupHeaderTemplate" DataType="{x:Type vm:ConnectionGroupNodeViewModel}">
            <Grid Height="42" Cursor="Hand" Background="Transparent"
                  Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="ContextMenu" Value="{StaticResource GroupMenu}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUngrouped}" Value="True">
                                <Setter Property="ContextMenu" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}" />
                </Grid.InputBindings>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 多选模式下的组头三态 Checkbox：未选/部分/全选该分组（含子分组）。 -->
                    <CheckBox Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,4,0"
                              IsThreeState="True"
                              IsChecked="{Binding SelectionState, Mode=OneWay}"
                              IsEnabled="{Binding HasAnyConnections}"
                              ToolTip="全选 / 取消全选该分组"
                              PreviewMouseLeftButtonDown="OnGroupHeaderCheckMouseDown">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Width="18" TextAlignment="Center"
                               Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{StaticResource Icon.ChevronRight}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="{StaticResource Icon.ChevronDown}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{StaticResource Icon.Folder}" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" Margin="8,0,0,0"
                               MaxWidth="360" TextTrimming="CharacterEllipsis" />
                    <Border Background="{DynamicResource Bg.Subtle}" BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="1"
                            CornerRadius="9" Padding="7,1" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource Text.Label}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Width="30" Height="30"
                        Content="{StaticResource Icon.More}" ToolTip="分组操作"
                        Visibility="{Binding IsUngrouped, Converter={StaticResource InverseBoolToVisibility}}"
                        Click="OnGroupMenuClick"
                        ContextMenu="{StaticResource GroupMenu}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 页内工具条 / 日期范围 ─────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding IsRecentView, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Height="34"
                    Background="{DynamicResource Bg.Layer}" BorderBrush="{DynamicResource Stroke.Default}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Medium}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{StaticResource Icon.Search}" FontFamily="{StaticResource IconFont}"
                               FontSize="12" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBox x:Name="PageFilterBox" Grid.Column="1"
                             Text="{Binding PageFilterText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             Background="Transparent" BorderThickness="0" FontSize="12"
                             VerticalContentAlignment="Center" Margin="8,0,10,0" />
                    <TextBlock Grid.Column="1" Text="筛选名称、IP 或标签" IsHitTestVisible="False"
                               Foreground="{DynamicResource Text.Tertiary}" FontSize="12" VerticalAlignment="Center" Margin="9,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=PageFilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <ComboBox Grid.Column="1" Style="{StaticResource Input.ComboBox}" MinWidth="120" Height="34" Margin="8,0,0,0"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding ProtocolFilterOptions}" SelectedItem="{Binding ProtocolFilter}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Converter={StaticResource EnumDisplay}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="All">
                                            <Setter Property="Text" Value="全部协议" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox Grid.Column="3" Style="{StaticResource Input.ComboBox}" MinWidth="132" Height="34"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding SortModeOptions}" SelectedItem="{Binding SortMode}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="按名称排序" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="LastConnected">
                                            <Setter Property="Text" Value="按最近连接排序" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Protocol">
                                            <Setter Property="Text" Value="按协议排序" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- 最近连接：时间范围 chip -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"
                    Visibility="{Binding IsRecentView, Converter={StaticResource BoolToVisibility}}">
            <RadioButton Style="{StaticResource Segment}" GroupName="RecentRange" Content="今天"
                         IsChecked="{Binding RecentRange, Converter={StaticResource EnumToBool}, ConverterParameter=Today, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="RecentRange" Content="7 天"
                         IsChecked="{Binding RecentRange, Converter={StaticResource EnumToBool}, ConverterParameter=Week, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="RecentRange" Content="全部" Margin="0"
                         IsChecked="{Binding RecentRange, Converter={StaticResource EnumToBool}, ConverterParameter=All, Mode=TwoWay}" />
        </StackPanel>

        <!-- ── 页面标题与工具条 ──────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 收藏与最近是同一页面的两个筛选视图，标题随之变化 -->
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}">
                            <Setter Property="Text" Value="我的连接" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filter}" Value="Favorites">
                                    <Setter Property="Text" Value="收藏" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Filter}" Value="Recent">
                                    <Setter Property="Text" Value="最近连接" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Background="{DynamicResource Bg.Subtle}"
                        CornerRadius="10" Padding="8,2" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Items.Count}" Style="{StaticResource Text.Caption}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ToggleButton Style="{StaticResource MultiSelectToggle}"
                              IsChecked="{Binding IsMultiSelect}"
                              ToolTip="多选：对多台设备批量连接 / 收藏 / 分组 / 标签 / 删除">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Accept}" FontFamily="{StaticResource IconFont}"
                                   FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="多选" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Button Style="{StaticResource Button.Icon}"
                        Content="{StaticResource Icon.Refresh}"
                        ToolTip="刷新"
                        Command="{Binding RefreshCommand}" />

                <!-- 新建 ▾：连接 / 分组（仅「我的连接」视图；连接的主入口在标题栏）-->
                <Button Style="{StaticResource Button.Secondary}"
                        MinHeight="32" Padding="12,0" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnNewMenuClick"
                        Visibility="{Binding IsGroupedView, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Add}" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="新建" Margin="7,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{StaticResource Icon.ChevronDown}" FontFamily="{StaticResource IconFont}" FontSize="9"
                                   Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="新建连接" Click="OnNewConnectionMenuClick" />
                            <MenuItem Header="新建分组" Click="OnNewGroupMenuClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── 搜索结果提示 ──────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brand.Subtle}"
                CornerRadius="{StaticResource Radius.Medium}"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding SearchText.Length, Converter={StaticResource CountToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{StaticResource Icon.Search}"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="12"
                           Foreground="{DynamicResource Brand.Default}"
                           VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="8,0,0,0">
                    <Run Text="正在搜索" />
                    <Run Text="{Binding SearchText, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="，找到" />
                    <Run Text="{Binding Items.Count, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="条结果" />
                </TextBlock>
                <Button Style="{StaticResource Button.Subtle}"
                        Content="清除"
                        MinHeight="24"
                        Padding="8,0"
                        FontSize="12"
                        Margin="12,0,0,0"
                        Command="{Binding ClearSearchCommand}" />
            </StackPanel>
        </Border>

        <!-- 列表卡片：机身与内容同一基色（Windows 11 默认配色思路）之后，
             列表需要一个显式的白卡片边界才不会跟机身糊在一起。列头 / 分隔线 /
             列表都装进这一张卡片。 -->
        <Border Grid.Row="3" Style="{StaticResource Surface.Card}" Padding="6,4,6,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ── 多选状态条：未勾选时只有提示；真正勾选后才出现业务操作 ── -->
                <Grid Grid.Row="0" MinHeight="34" Margin="4,0,4,8"
                      Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVisibility}}">

                    <!-- 已进入多选、未勾选任何项：轻提示 + 关闭 -->
                    <Grid Visibility="{Binding IsSelectionHintVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.BodySecondary}" FontSize="12"
                                   VerticalAlignment="Center" Text="选择需要批量操作的连接" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                Content="{StaticResource Icon.Close}" ToolTip="退出多选"
                                Command="{Binding ExitMultiSelectCommand}" />
                    </Grid>

                    <!-- 已勾选 ≥1 项：上下文批量操作栏 -->
                    <Grid Visibility="{Binding IsBatchBarVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Text="{Binding SelectionSummary}" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Subtle}" MinHeight="24" Padding="6,0"
                                Margin="10,0,0,0" Content="取消选择" FontSize="12" VerticalAlignment="Center"
                                Command="{Binding ClearSelectionCommand}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Secondary}" MinHeight="28" Padding="10,0"
                                    FontSize="12" Click="OnBatchMoveClick" Tag="move">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="移动到分组" VerticalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Icon.ChevronDown}" FontFamily="{StaticResource IconFont}"
                                               FontSize="9" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" MinHeight="28" Padding="10,0"
                                    Margin="6,0,0,0" FontSize="12" Click="OnBatchTagClick" Tag="tag">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="添加标签" VerticalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Icon.ChevronDown}" FontFamily="{StaticResource IconFont}"
                                               FontSize="9" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" MinHeight="28" Padding="10,0"
                                    Margin="6,0,0,0" FontSize="12"
                                    Content="{Binding FavoriteActionText}"
                                    Command="{Binding ToggleFavoriteSelectedCommand}" />
                            <Button Style="{StaticResource Button.Secondary}" MinHeight="28" Padding="10,0"
                                    Margin="6,0,0,0" FontSize="12" Click="OnBatchMoreClick" Tag="more">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="更多" VerticalAlignment="Center" />
                                    <TextBlock Text="{StaticResource Icon.ChevronDown}" FontFamily="{StaticResource IconFont}"
                                               FontSize="9" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" MinHeight="28" Padding="10,0"
                                    Margin="10,0,0,0" FontSize="12"
                                    Content="删除" Foreground="{DynamicResource Status.Danger}"
                                    Command="{Binding DeleteSelectedCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ── 列头 ──────────────────────────────────────────── -->
                <!-- 列头只在扁平视图（收藏 / 最近连接）出现。
                     分组视图是一棵带缩进的树，再压一行表头既对不齐也没必要。 -->
                <Grid Grid.Row="1" Height="30" Margin="4,0,4,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsGroupedView}" Value="False" />
                                <Condition Binding="{Binding IsEmpty}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="460" SharedSizeGroup="ColName" />
                <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="ColHost" />
                <ColumnDefinition Width="Auto" MinWidth="56" SharedSizeGroup="ColProto" />
                <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="ColTags" />
                <ColumnDefinition Width="*" MinWidth="24" />
                <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="ColRecent" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <!-- 全选（仅多选模式出现）：勾选 / 取消当前可见全部 -->
            <CheckBox Grid.Column="0" Width="26" Height="26" Margin="5,0,0,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                      ToolTip="全选当前列表"
                      Click="OnSelectAllHeaderClick"
                      Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource Text.Label}" Margin="42,0,0,0" />
            <TextBlock Grid.Column="2" Text="IP / 主机" Style="{StaticResource Text.Label}" Margin="16,0,0,0" />
            <TextBlock Grid.Column="3" Text="协议" Style="{StaticResource Text.Label}" Margin="16,0,0,0" />
            <TextBlock Grid.Column="4" Text="标签" Style="{StaticResource Text.Label}" Margin="16,0,0,0" />
            <TextBlock Grid.Column="6" Text="最近连接" Style="{StaticResource Text.Label}" />
        </Grid>

                <Border Grid.Row="2" VerticalAlignment="Bottom" Margin="4,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Surface.Divider}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsGroupedView}" Value="False" />
                                        <Condition Binding="{Binding IsEmpty}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- ── 连接列表 ──────────────────────────────────────── -->
                <Grid Grid.Row="3">

            <!-- 收藏 / 最近连接：扁平列表（最近连接按日期桶分组）-->
            <ListBox x:Name="ConnectionList"
                     ItemContainerStyle="{StaticResource ConnectionRow}"
                     ItemTemplate="{StaticResource ConnRowTemplate}"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     Margin="0,4,0,0"
                     MouseDoubleClick="OnListDoubleClick"
                     KeyDown="OnListKeyDown">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource List.Plain}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGroupedView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                                        <TextBlock Text="{StaticResource Icon.Recent}"
                                                                   FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                   Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                   Foreground="{DynamicResource Text.Primary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ItemCount}" FontSize="11" Foreground="{DynamicResource Text.Tertiary}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <!-- 我的连接：分组树（摊平为混合行）-->
            <ListBox x:Name="GroupedList"
                     ItemContainerStyle="{StaticResource GroupedRow}"
                     ItemsSource="{Binding GroupedRows}"
                     SelectedItem="{Binding SelectedItem}"
                     Margin="0,4,0,0"
                     MouseDoubleClick="OnListDoubleClick"
                     KeyDown="OnListKeyDown">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource List.Plain}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGroupedView}" Value="True" />
                                    <Condition Binding="{Binding IsGroupedEmpty}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type vm:ConnectionGroupNodeViewModel}">
                        <StackPanel>
                            <ContentControl ContentTemplate="{StaticResource GroupHeaderTemplate}" Content="{Binding}" />
                            <TextBlock Text="暂无连接　·　右键分组或点「+ 新建」添加"
                                       Margin="44,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                    <Condition Binding="{Binding IsEmptyGroup}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectionItemViewModel}">
                        <ContentControl ContentTemplate="{StaticResource ConnRowTemplate}" Content="{Binding}" Margin="20,0,0,0" />
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <!-- ── 空状态：收藏 / 最近连接为空，或「我的连接」一个分组都没有 ── -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsGroupedView}" Value="False" />
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsGroupedEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Bg.Subtle}" HorizontalAlignment="Center">
                    <TextBlock Text="{StaticResource Icon.Connections}" FontFamily="{StaticResource IconFont}" FontSize="24"
                               Foreground="{DynamicResource Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Text.BodySecondary}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
                <Button Style="{StaticResource Button.Primary}" Content="新建连接" HorizontalAlignment="Center"
                        Margin="0,20,0,0" Command="{Binding CreateCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</UserControl>
